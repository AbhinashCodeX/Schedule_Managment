@model IEnumerable<Schedule_Management.ViewModels.CoachAvailabilityViewModel>

@{
    ViewData["Title"] = "My Availability";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-check"></i>
                My Availability
            </h2>

            <p class="text-muted mb-0">
                Manage your available activity dates and time slots.
            </p>
        </div>

        <div>
            <a asp-controller="Coach"
               asp-action="Dashboard"
               class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addAvailabilityModal">
                <i class="bi bi-plus-circle"></i>
                Add Availability
            </button>
        </div>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <form asp-controller="Coach"
                          asp-action="MyAvailability"
                          method="get"
                          class="row g-2 mb-4">

                        <div class="col-md-3">

                            <select name="activityTypeId"
                                    class="form-select">

                                <option value="">
                                    All Activities
                                </option>

                                @foreach (var activity in ViewBag.ActivityTypes)
                                {
                                    <option value="@activity.ActivityTypeId"
                                            selected="@(ViewBag.SelectedActivityTypeId == activity.ActivityTypeId)">
                                        @activity.ActivityName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="col-md-3">

                            <input type="date"
                                   name="date"
                                   value="@(ViewBag.SelectedDate?.ToString("yyyy-MM-dd"))"
                                   class="form-control" />

                        </div>


                        <div class="col-md-2">

                            <select name="status"
                                    class="form-select">

                                <option value="">
                                    All Status
                                </option>

                                <option value="Active"
                                        selected="@(ViewBag.Status == "Active")">
                                    Active
                                </option>

                                <option value="Inactive"
                                        selected="@(ViewBag.Status == "Inactive")">
                                    Inactive
                                </option>

                            </select>

                        </div>
                        <div class="col-md-2">
                            <select name="bookingStatus"
                                    class="form-select">

                                <option value="">
                                    All Booking Status
                                </option>

                                <option value="Available"
                                        selected="@(ViewBag.BookingStatus == "Available")">
                                    Available
                                </option>

                                <option value="Booked"
                                        selected="@(ViewBag.BookingStatus == "Booked")">
                                    Booked
                                </option>

                                <option value="Unavailable"
                                        selected="@(ViewBag.BookingStatus == "Unavailable")">
                                    Unavailable
                                </option>

                            </select>
                        </div>
                        <!--Filtering UI-->
                        <div class="col-md-2">
                            <select name="sortOrder"
                                    class="form-select">

                                <option value=""
                                        selected="@(string.IsNullOrEmpty(ViewBag.SortOrder))">
                                    Date Ascending
                                </option>

                                <option value="date_desc"
                                        selected="@(ViewBag.SortOrder == "date_desc")">
                                    Date Descending
                                </option>

                                <option value="time_asc"
                                        selected="@(ViewBag.SortOrder == "time_asc")">
                                    Time Ascending
                                </option>

                                <option value="time_desc"
                                        selected="@(ViewBag.SortOrder == "time_desc")">
                                    Time Descending
                                </option>

                            </select>
                        </div>


                        <div class="col-auto">
                            <button type="submit"
                                    class="btn btn-primary">
                                Filter
                            </button>
                        </div>


                        <div class="col-auto">
                            <a asp-controller="Coach"
                               asp-action="MyAvailability"
                               class="btn btn-secondary">
                                Reset
                            </a>
                        </div>

                    </form>


                    @if (!Model.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No availability records found.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>Activity</th>
                                        <th>Date</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Booking</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr>

                                            <td>
                                                @item.ActivityName
                                            </td>

                                            <td>
                                                @item.AvailableDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @item.StartTime.ToString("hh:mm tt")
                                            </td>

                                            <td>
                                                @item.EndTime.ToString("hh:mm tt")
                                            </td>

                                            <td>
                                                @if (item.IsBooked)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Booked
                                                    </span>
                                                }
                                                else if (!item.IsActive)
                                                {
                                                    <span class="badge bg-secondary">
                                                        Unavailable
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        Available
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                <span id="availability-status-@item.AvailabilityId"
                                                      class="badge @(item.IsActive ? "bg-success" : "bg-danger")">

                                                    @(item.IsActive ? "Active" : "Inactive")

                                                </span>
                                            </td>

                                            <td>
                                                <button type="button"
                                                        class="btn btn-warning btn-sm btn-edit-availability"
                                                        data-id="@item.AvailabilityId">
                                                    Edit
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success") btn-change-availability-status"
                                                        data-id="@item.AvailabilityId"
                                                        data-active="@item.IsActive.ToString().ToLower()">

                                                    @(item.IsActive ? "Deactivate" : "Activate")
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger btn-sm btn-delete-availability"
                                                        data-id="@item.AvailabilityId">
                                                    Delete
                                                </button>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav class="mt-4">
                                <ul class="pagination justify-content-center">

                                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                                        <a class="page-link"
                                           asp-action="MyAvailability"
                                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                                           asp-route-activityTypeId="@ViewBag.SelectedActivityTypeId"
                                           asp-route-date="@ViewBag.SelectedDate"
                                           asp-route-status="@ViewBag.Status"
                                           asp-route-bookingStatus="@ViewBag.BookingStatus"
                                           asp-route-sortOrder="@ViewBag.SortOrder">
                                            Previous
                                        </a>

                                    </li>


                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                                            <a class="page-link"
                                               asp-action="MyAvailability"
                                               asp-route-page="@i"
                                               asp-route-activityTypeId="@ViewBag.SelectedActivityTypeId"
                                               asp-route-date="@ViewBag.SelectedDate"
                                               asp-route-status="@ViewBag.Status"
                                               asp-route-bookingStatus="@ViewBag.BookingStatus"
                                               asp-route-sortOrder="@ViewBag.SortOrder">
                                                @i
                                            </a>

                                        </li>
                                    }


                                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                                        <a class="page-link"
                                           asp-action="MyAvailability"
                                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                                           asp-route-activityTypeId="@ViewBag.SelectedActivityTypeId"
                                           asp-route-date="@ViewBag.SelectedDate"
                                           asp-route-status="@ViewBag.Status"
                                           asp-route-bookingStatus="@ViewBag.BookingStatus"
                                           asp-route-sortOrder="@ViewBag.SortOrder">
                                            Next
                                        </a>

                                    </li>

                                </ul>
                            </nav>
                        }
                    }

                </div>

            </div>

        </div>

        <!--Modal-->
        <div class="modal fade"
             id="addAvailabilityModal"
             tabindex="-1"
             aria-labelledby="addAvailabilityModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="addAvailabilityModalLabel">
                            Add Availability
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <form id="addAvailabilityForm">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">

                                <label class="form-label">
                                    Activity Type
                                </label>

                                <select id="activityTypeId"
                                        name="ActivityTypeId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Activity --
                                    </option>

                                    @foreach (var item in ViewBag.ActivityTypes)
                                    {
                                        <option value="@item.ActivityTypeId">
                                            @item.ActivityName
                                        </option>
                                    }

                                </select>

                                <span id="activityTypeError"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <label class="form-label">
                                        From Date
                                    </label>

                                    <input type="date"
                                           id="fromDate"
                                           name="FromDate"
                                           class="form-control" />

                                    <span id="fromDateError"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <div class="col-md-6 mb-3">

                                    <label class="form-label">
                                        To Date
                                    </label>

                                    <input type="date"
                                           id="toDate"
                                           name="ToDate"
                                           class="form-control" />

                                    <span id="toDateError"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>


                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <label class="form-label">
                                        Start Time
                                    </label>

                                    <input type="time"
                                           id="startTime"
                                           name="StartTime"
                                           class="form-control" />

                                    <span id="startTimeError"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <div class="col-md-6 mb-3">

                                    <label class="form-label">
                                        End Time
                                    </label>

                                    <input type="time"
                                           id="endTime"
                                           name="EndTime"
                                           class="form-control" />

                                    <span id="endTimeError"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </form>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="btnSaveAvailability">
                            Save Availability
                        </button>

                    </div>

                </div>
            </div>
        </div>

        @section Scripts
        {
            <script>

                        $("#btnSaveAvailability").click(function() {

                            // Old errors clear
                            $("#activityTypeError").text("");
                            $("#fromDateError").text("");
                            $("#toDateError").text("");
                            $("#startTimeError").text("");
                            $("#endTimeError").text("");

                            var activityTypeId = $("#activityTypeId").val();
                            var fromDate = $("#fromDate").val();
                            var toDate = $("#toDate").val();
                            var startTime = $("#startTime").val();
                            var endTime = $("#endTime").val();

                            var isValid = true;


                            // Activity validation
                            if (!activityTypeId) {
                                $("#activityTypeError")
                                    .text("Please select an Activity Type.");

                                isValid = false;
                            }


                            // From Date
                            if (!fromDate) {
                                $("#fromDateError")
                                    .text("From Date is required.");

                                isValid = false;
                            }


                            // To Date
                            if (!toDate) {
                                $("#toDateError")
                                    .text("To Date is required.");

                                isValid = false;
                            }


                            // Start Time
                            if (!startTime) {
                                $("#startTimeError")
                                    .text("Start Time is required.");

                                isValid = false;
                            }


                            // End Time
                            if (!endTime) {
                                $("#endTimeError")
                                    .text("End Time is required.");

                                isValid = false;
                            }


                            if (!isValid) {
                                return;
                            }


                            // Date validation
                            if (toDate < fromDate) {

                                $("#toDateError")
                                    .text("To Date cannot be before From Date.");

                                return;
                            }


                            // Time validation
                            if (endTime <= startTime) {

                                $("#endTimeError")
                                    .text("End Time must be greater than Start Time.");

                                return;
                            }


                            var token =
                                $('input[name="__RequestVerificationToken"]').val();


                            $.ajax({

                                url: '@Url.Action("CreateAvailability", "Coach")',

                                type: 'POST',

                                data: {
                                    __RequestVerificationToken: token,

                                    ActivityTypeId: activityTypeId,
                                    FromDate: fromDate,
                                    ToDate: toDate,
                                    StartTime: startTime,
                                    EndTime: endTime
                                },


                                success: function(response) {

                                    if (response.success) {

                                        toastr.success(response.message);

                                        var modalElement =
                                            document.getElementById(
                                                "addAvailabilityModal"
                                            );

                                        var modal =
                                            bootstrap.Modal.getInstance(
                                                modalElement
                                            );

                                        modal.hide();


                                        setTimeout(function() {

                                            location.reload();

                                        }, 700);

                                    }
                                    else {

                                        toastr.error(response.message);
                                    }

                                },


                                error: function() {

                                    toastr.error(
                                        "Something went wrong while adding availability."
                                    );

                                }

                            });

                        });

                        $(document).on("click", ".btn-edit-availability", function() {

                            var availabilityId = $(this).data("id");

                            $.ajax({
                                url: '@Url.Action("GetAvailabilityById", "Coach")',
                                type: 'GET',
                                data: {
                                    id: availabilityId
                                },

                                success: function(response) {

                                    if (response.success) {

                                        $("#editAvailabilityId")
                                            .val(response.data.availabilityId);

                                        $("#editActivityTypeId")
                                            .val(response.data.activityTypeId);

                                        $("#editAvailableDate")
                                            .val(response.data.availableDate);

                                        $("#editStartTime")
                                            .val(response.data.startTime);

                                        $("#editEndTime")
                                            .val(response.data.endTime);

                                        var modal =
                                            new bootstrap.Modal(
                                                document.getElementById(
                                                    "editAvailabilityModal"
                                                )
                                            );

                                        modal.show();
                                    }
                                    else {
                                        toastr.error(response.message);
                                    }
                                },

                                error: function() {
                                    toastr.error(
                                        "Something went wrong while loading availability."
                                    );
                                }
                            });
                        });

                        $("#btnUpdateAvailability").click(function() {

                            $("#editActivityError").text("");
                            $("#editDateError").text("");
                            $("#editStartTimeError").text("");
                            $("#editEndTimeError").text("");

                            var availabilityId =
                                $("#editAvailabilityId").val();

                            var activityTypeId =
                                $("#editActivityTypeId").val();

                            var availableDate =
                                $("#editAvailableDate").val();

                            var startTime =
                                $("#editStartTime").val();

                            var endTime =
                                $("#editEndTime").val();

                            var isValid = true;

                            if (!activityTypeId) {
                                $("#editActivityError")
                                    .text("Please select an Activity Type.");

                                isValid = false;
                            }

                            if (!availableDate) {
                                $("#editDateError")
                                    .text("Available Date is required.");

                                isValid = false;
                            }

                            if (!startTime) {
                                $("#editStartTimeError")
                                    .text("Start Time is required.");

                                isValid = false;
                            }

                            if (!endTime) {
                                $("#editEndTimeError")
                                    .text("End Time is required.");

                                isValid = false;
                            }

                            if (!isValid) {
                                return;
                            }

                            if (endTime <= startTime) {
                                $("#editEndTimeError")
                                    .text("End Time must be greater than Start Time.");

                                return;
                            }

                            var token =
                                $('input[name="__RequestVerificationToken"]').first().val();

                            $.ajax({
                                url: '@Url.Action("UpdateAvailability", "Coach")',
                                type: 'POST',

                                data: {
                                    __RequestVerificationToken: token,

                                    AvailabilityId: availabilityId,
                                    ActivityTypeId: activityTypeId,
                                    AvailableDate: availableDate,
                                    StartTime: startTime,
                                    EndTime: endTime
                                },

                                success: function(response) {

                                    if (response.success) {

                                        toastr.success(response.message);

                                        var modal =
                                            bootstrap.Modal.getInstance(
                                                document.getElementById(
                                                    "editAvailabilityModal"
                                                )
                                            );

                                        modal.hide();

                                        setTimeout(function() {
                                            location.reload();
                                        }, 700);
                                    }
                                    else {
                                        toastr.error(response.message);
                                    }
                                },

                                error: function() {
                                    toastr.error(
                                        "Something went wrong while updating availability."
                                    );
                                }
                            });
                        });

                        $(document).on("click", ".btn-change-availability-status", function() {

                            var button = $(this);

                            var availabilityId = button.data("id");
                            var isActive = button.data("active");

                            var actionText =
                                isActive ? "deactivate" : "activate";

                            Swal.fire({
                                title: "Are you sure?",
                                text: "Do you want to " + actionText + " this availability?",
                                icon: "warning",

                                showCancelButton: true,

                                confirmButtonText:
                                    "Yes, " + actionText,

                                cancelButtonText:
                                    "Cancel"

                            }).then(function(result) {

                                if (result.isConfirmed) {

                                    var token =
                                        $('input[name="__RequestVerificationToken"]')
                                            .first()
                                            .val();

                                    $.ajax({

                                        url: '@Url.Action("ChangeAvailabilityStatus", "Coach")',

                                        type: 'POST',

                                        data: {
                                            __RequestVerificationToken: token,
                                            id: availabilityId
                                        },

                                        success: function(response) {

                                            if (response.success) {

                                                toastr.success(response.message);

                                                var badge =
                                                    $("#availability-status-" + availabilityId);

                                                if (response.isActive) {

                                                    badge
                                                        .removeClass("bg-danger")
                                                        .addClass("bg-success")
                                                        .text("Active");

                                                    button
                                                        .removeClass("btn-success")
                                                        .addClass("btn-danger")
                                                        .text("Deactivate");

                                                    button.data("active", true);
                                                }
                                                else {

                                                    badge
                                                        .removeClass("bg-success")
                                                        .addClass("bg-danger")
                                                        .text("Inactive");

                                                    button
                                                        .removeClass("btn-danger")
                                                        .addClass("btn-success")
                                                        .text("Activate");

                                                    button.data("active", false);
                                                }
                                            }
                                            else {
                                                toastr.error(response.message);
                                            }

                                        },

                                        error: function() {

                                            toastr.error(
                                                "Something went wrong while changing availability status."
                                            );

                                        }

                                    });
                                }

                            });

                        });

                        $(document).on("click", ".btn-delete-availability", function() {

                            var button = $(this);
                            var availabilityId = button.data("id");

                            Swal.fire({
                                title: "Are you sure?",
                                text: "This availability will be permanently deleted.",
                                icon: "warning",
                                showCancelButton: true,
                                confirmButtonText: "Yes, delete it",
                                cancelButtonText: "Cancel"
                            }).then(function(result) {

                                if (result.isConfirmed) {

                                    var token =
                                        $('input[name="__RequestVerificationToken"]')
                                            .first()
                                            .val();

                                    $.ajax({
                                        url: '@Url.Action("DeleteAvailability", "Coach")',
                                        type: 'POST',

                                        data: {
                                            __RequestVerificationToken: token,
                                            id: availabilityId
                                        },

                                        success: function(response) {

                                            if (response.success) {

                                                toastr.success(response.message);

                                                // jis row ka button click hua tha
                                                button.closest("tr").fadeOut(400, function() {
                                                    $(this).remove();
                                                });
                                            }
                                            else {
                                                toastr.error(response.message);
                                            }
                                        },

                                        error: function() {
                                            toastr.error(
                                                "Something went wrong while deleting availability."
                                            );
                                        }
                                    });
                                }
                            });
                        });

            </script>
        }

        <!---Modal--->
        <div class="modal fade"
             id="editAvailabilityModal"
             tabindex="-1"
             aria-labelledby="editAvailabilityModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="editAvailabilityModalLabel">
                            Edit Availability
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <form id="editAvailabilityForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   id="editAvailabilityId"
                                   name="AvailabilityId" />

                            <div class="mb-3">
                                <label class="form-label">
                                    Activity Type
                                </label>

                                <select id="editActivityTypeId"
                                        name="ActivityTypeId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Activity --
                                    </option>

                                    @foreach (var item in ViewBag.ActivityTypes)
                                    {
                                        <option value="@item.ActivityTypeId">
                                            @item.ActivityName
                                        </option>
                                    }

                                </select>

                                <span id="editActivityError"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Available Date
                                </label>

                                <input type="date"
                                       id="editAvailableDate"
                                       name="AvailableDate"
                                       class="form-control" />

                                <span id="editDateError"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Start Time
                                    </label>

                                    <input type="time"
                                           id="editStartTime"
                                           name="StartTime"
                                           class="form-control" />

                                    <span id="editStartTimeError"
                                          class="text-danger small">
                                    </span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        End Time
                                    </label>

                                    <input type="time"
                                           id="editEndTime"
                                           name="EndTime"
                                           class="form-control" />

                                    <span id="editEndTimeError"
                                          class="text-danger small">
                                    </span>
                                </div>

                            </div>

                        </form>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="btnUpdateAvailability">
                            Update Availability
                        </button>

                    </div>

                </div>
            </div>
        </div>
