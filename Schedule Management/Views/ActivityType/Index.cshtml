@model IEnumerable<Schedule_Management.ViewModels.ActivityTypeViewModel>

@{
    ViewData["Title"] = "Activity Types";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-list-check"></i>
                Manage Activity Types
            </h2>

            <p class="text-muted mb-0">
                Add and manage available sports and activities.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

            <a asp-controller="ActivityType"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Add Activity
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No activity types found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Activity Name</th>
                                <th>Status</th>
                                <th>Created On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@serialNumber</td>

                                    <td>
                                        <strong>
                                            @item.ActivityName
                                        </strong>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(item.CreatedOn.HasValue
                                            ? item.CreatedOn.Value
                                                .ToString("dd MMM yyyy")
                                            : "Not available")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-controller="ActivityType"
                                               asp-action="Edit"
                                               asp-route-id="@item.ActivityTypeId"
                                               class="btn btn-sm btn-warning">

                                                <i class="bi bi-pencil-square"></i>
                                                Edit
                                            </a>

                                            <form asp-controller="ActivityType"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@item.ActivityTypeId"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                @if (item.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">

                                                        <i class="bi bi-x-circle"></i>
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">

                                                        <i class="bi bi-check-circle"></i>
                                                        Activate
                                                    </button>
                                                }

                                            </form>

                                        </div>
                                    </td>
                                </tr>

                                serialNumber++;
                            }

                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>
</div>