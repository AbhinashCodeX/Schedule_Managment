@model IEnumerable<Schedule_Management.ViewModels.ActivityTypeViewModel>

@{
    ViewData["Title"] = "Activity Types";
}



<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-list-check"></i>
            Manage Activity Types
        </h2>

        <p class="text-muted mb-0">
            Add and manage available sports and activities.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

        <a asp-controller="ActivityType"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Add Activity
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <!-- Search + Filter Form -->
        <form method="get"
              asp-controller="ActivityType"
              asp-action="Index"
              class="row g-3 mb-4">

            <input type="hidden"
                   name="sortOrder"
                   value="@ViewBag.SortOrder" />

            <div class="col-md-5">
                <label class="form-label fw-semibold">
                    Search Activity
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by activity name..." />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    Status
                </label>

                <select name="status"
                        class="form-select">

                    <option value="">All</option>

                    <option value="Active"
                            selected="@(ViewBag.Status == "Active")">
                        Active
                    </option>

                    <option value="Inactive"
                            selected="@(ViewBag.Status == "Inactive")">
                        Inactive
                    </option>

                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-controller="ActivityType"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </a>

            </div>

        </form>

        <!--Ye sirf count krega Data-->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                Total Records:
                <span class="badge bg-primary">
                    @ViewBag.TotalRecords
                </span>
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No activity types found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>

                            <th>
                                <a asp-controller="ActivityType"
                                   asp-action="Index"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-sortOrder="@(ViewBag.SortOrder == "name_asc"
                                                                                          ? "name_desc"
                                                                                          : "name_asc")"
                                   asp-route-page="1"
                                   class="text-white text-decoration-none">

                                    Activity Name

                                    @if (ViewBag.SortOrder == "name_asc")
                                    {
                                        <i class="bi bi-arrow-up"></i>
                                    }
                                    else if (ViewBag.SortOrder == "name_desc")
                                    {
                                        <i class="bi bi-arrow-down"></i>
                                    }
                                </a>
                            </th>

                            <th>Status</th>

                            <th>
                                <a asp-controller="ActivityType"
                                   asp-action="Index"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-sortOrder="@(ViewBag.SortOrder == "date_asc"
                                                                                          ? "date_desc"
                                                                                          : "date_asc")"
                                   asp-route-page="1"
                                   class="text-white text-decoration-none">

                                    Created On

                                    @if (ViewBag.SortOrder == "date_asc")
                                    {
                                        <i class="bi bi-arrow-up"></i>
                                    }
                                    else if (ViewBag.SortOrder == "date_desc")
                                    {
                                        <i class="bi bi-arrow-down"></i>
                                    }
                                </a>
                            </th>

                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int pageSize = 5;

                            int serialNumber =
                                ((int)ViewBag.CurrentPage - 1)
                                * pageSize + 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@serialNumber</td>

                                <td>
                                    <strong>
                                        @item.ActivityName
                                    </strong>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.CreatedOn.HasValue
                                        ? item.CreatedOn.Value
                                            .ToString("dd MMM yyyy")
                                        : "Not available")
                                </td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="ActivityType"
                                           asp-action="Edit"
                                           asp-route-id="@item.ActivityTypeId"
                                           class="btn btn-sm btn-warning">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>

                                        <form asp-controller="ActivityType"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@item.ActivityTypeId"
                                              method="post"
                                              class="toggle-status-form"
                                              data-activity-name="@item.ActivityName"
                                              data-is-active="@item.IsActive.ToString().ToLower()">

                                            @Html.AntiForgeryToken()

                                            @if (item.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    <i class="bi bi-x-circle"></i>
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="bi bi-check-circle"></i>
                                                    Activate
                                                </button>
                                            }

                                        </form>

                                    </div>
                                </td>
                            </tr>

                            serialNumber++;
                        }

                    </tbody>
                </table>

            </div>
            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="ActivityType"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-search="@ViewBag.Search"
                               asp-route-status="@ViewBag.Status"
                               asp-route-sortOrder="@ViewBag.SortOrder">

                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="ActivityType"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-sortOrder="@ViewBag.SortOrder">

                                    @i
                                </a>

                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="ActivityType"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-search="@ViewBag.Search"
                               asp-route-status="@ViewBag.Status"
                               asp-route-sortOrder="@ViewBag.SortOrder">

                                Next
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        }

    </div>
</div>
@*Sweet Alert Js*@
@section Scripts {
    <script>
        $(document).ready(function() {

            $(".toggle-status-form").on("submit", function(event) {

                event.preventDefault();

                const form = this;

                const activityName =
                    $(form).data("activity-name");

                const isActive =
                    $(form).data("is-active") === true ||
                    $(form).data("is-active") === "true";

                const actionText = isActive
                    ? "deactivate"
                    : "activate";

                const buttonText = isActive
                    ? "Yes, deactivate"
                    : "Yes, activate";

                const confirmColor = isActive
                    ? "#dc3545"
                    : "#198754";

                Swal.fire({
                    title: `Are you sure?`,
                    text: `Do you want to ${actionText} ${activityName}?`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: confirmColor,
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: buttonText,
                    cancelButtonText: "Cancel",
                    reverseButtons: true
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });
            });

        });
    </script>
}