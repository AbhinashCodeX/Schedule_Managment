@model Schedule_Management.ViewModels.ActivityTypeViewModel

@{
    ViewData["Title"] = "Add Activity Type";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i>
                        Add Activity Type
                    </h4>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="ActivityType"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="ActivityName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ActivityName"
                                   class="form-control"
                                   placeholder="Enter activity name" />

                            <span asp-validation-for="ActivityName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check form-switch mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="ActivityType"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-save"></i>
                                Save Activity
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}