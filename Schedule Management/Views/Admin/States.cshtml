@model IEnumerable<Schedule_Management.ViewModels.StateViewModel>

@{
    ViewData["Title"] = "State Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                State Management
            </h2>

            <p class="text-muted mb-0">
                Manage states linked with countries.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addStateModal">

            <i class="bi bi-plus-circle me-1"></i>
            Add State

        </button>

    </div>
    <!-- FILTER SECTION -->
    <form method="get"
          asp-controller="Admin"
          asp-action="States"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search state, code or country..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Country</label>
            <select name="countryId" class="form-select">

                <option value="">All Countries</option>

                @foreach (var country in ViewBag.Countries)
                {
                    if (ViewBag.CountryId != null &&
                        Convert.ToInt32(ViewBag.CountryId) == country.CountryId)
                    {
                        <option value="@country.CountryId" selected>
                            @country.CountryName
                        </option>
                    }
                    else
                    {
                        <option value="@country.CountryId">
                            @country.CountryName
                        </option>
                    }
                }

            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Status</label>

            <select name="status" class="form-select">
                <option value="">All Status</option>

                @if (ViewBag.Status == "Active")
                {
                    <option value="Active" selected>Active</option>
                }
                else
                {
                    <option value="Active">Active</option>
                }

                @if (ViewBag.Status == "Inactive")
                {
                    <option value="Inactive" selected>Inactive</option>
                }
                else
                {
                    <option value="Inactive">Inactive</option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end gap-2">

            <button type="submit" class="btn btn-primary">
                Filter
            </button>

            <a asp-controller="Admin"
               asp-action="States"
               class="btn btn-secondary">
                Reset
            </a>

        </div>

    </form>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No states found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Country</th>
                                <th>State</th>
                                <th>State Code</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.CountryName
                                    </td>

                                    <td>
                                        @item.StateName
                                    </td>

                                    <td>
                                        @item.StateCode
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-edit-state"
                                                data-id="@item.StateId"
                                                data-country-id="@item.CountryId"
                                                data-name="@item.StateName"
                                                data-code="@item.StateCode">
                                            Edit
                                        </button>

                                        @if (item.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-toggle-state"
                                                    data-id="@item.StateId"
                                                    data-name="@item.StateName"
                                                    data-active="true">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success btn-toggle-state"
                                                    data-id="@item.StateId"
                                                    data-name="@item.StateName"
                                                    data-active="false">
                                                Activate
                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                
                <!-- PAGINATION -->
                @if (ViewBag.TotalPages > 0)
                {
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;

                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    <div class="d-flex justify-content-between align-items-center mt-3">

                        <small class="text-muted">
                            Total Records: @ViewBag.TotalRecords
                        </small>

                        <nav>
                            <ul class="pagination mb-0">

                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="States"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-countryId="@ViewBag.CountryId"
                                       asp-route-status="@ViewBag.Status">
                                        Previous
                                    </a>
                                </li>

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="States"
                                           asp-route-page="@i"
                                           asp-route-search="@ViewBag.Search"
                                           asp-route-countryId="@ViewBag.CountryId"
                                           asp-route-status="@ViewBag.Status">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="States"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-countryId="@ViewBag.CountryId"
                                       asp-route-status="@ViewBag.Status">
                                        Next
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                }
            }

        </div>

    </div>

</div>


<!-- ADD STATE MODAL -->
<div class="modal fade"
     id="addStateModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add State
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="addStateForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Country
                        </label>

                        <select name="CountryId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Country --
                            </option>

                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country.CountryId">
                                    @country.CountryName
                                </option>
                            }

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            State Name
                        </label>

                        <input type="text"
                               name="StateName"
                               class="form-control"
                               maxlength="200"
                               placeholder="Enter state name"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            State Code
                        </label>

                        <input type="text"
                               name="StateCode"
                               class="form-control text-uppercase"
                               maxlength="30"
                               placeholder="e.g. OD"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save State
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- EDIT STATE MODAL -->
<div class="modal fade"
     id="editStateModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form id="editStateForm">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Edit State
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="editStateId"
                           name="StateId" />


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Country
                        </label>

                        <select id="editCountryId"
                                name="CountryId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Country --
                            </option>

                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country.CountryId">
                                    @country.CountryName
                                </option>
                            }

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            State Name
                        </label>

                        <input type="text"
                               id="editStateName"
                               name="StateName"
                               class="form-control"
                               maxlength="200"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            State Code
                        </label>

                        <input type="text"
                               id="editStateCode"
                               name="StateCode"
                               class="form-control text-uppercase"
                               maxlength="30"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Update State
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<form id="stateStatusForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script>

        $("#addStateForm").on("submit", function(e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({

                url: '@Url.Action("CreateState", "Admin")',

                type: "POST",

                data: form.serialize(),

                success: function(response) {

                    if (response.success) {

                        toastr.success(response.message);

                        var modalElement =
                            document.getElementById("addStateModal");

                        var modalInstance =
                            bootstrap.Modal.getInstance(modalElement);

                        modalInstance.hide();

                        setTimeout(function() {
                            location.reload();
                        }, 700);

                    }
                    else {

                        toastr.error(response.message);

                    }

                },

                error: function() {

                    toastr.error(
                        "Something went wrong while adding state."
                    );

                }

            });

        });

        // OPEN EDIT STATE MODAL
        $(document).on("click", ".btn-edit-state", function() {

            var button = $(this);

            $("#editStateId").val(button.data("id"));
            $("#editCountryId").val(button.data("country-id"));
            $("#editStateName").val(button.data("name"));
            $("#editStateCode").val(button.data("code"));

            var modal =
                new bootstrap.Modal(
                    document.getElementById("editStateModal")
                );

            modal.show();
        });

        // UPDATE STATE
        $("#editStateForm").on("submit", function(e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({

                url: '@Url.Action("EditState", "Admin")',

                type: "POST",

                data: form.serialize(),

                success: function(response) {

                    if (response.success) {

                        toastr.success(response.message);

                        var modalElement =
                            document.getElementById("editStateModal");

                        var modalInstance =
                            bootstrap.Modal.getInstance(modalElement);
    
                        modalInstance.hide();

                        setTimeout(function() {
                            location.reload();
                        }, 700);
                    }
                    else {
                        toastr.error(response.message);
                    }
                },

                error: function() {

                    toastr.error(
                        "Something went wrong while updating state."
                    );

                }

            });

        });

        $(document).on("click", ".btn-toggle-state", function() {

            var button = $(this);

            var stateId = button.data("id");
            var stateName = button.data("name");
            var isActive = button.data("active");

            var actionText = isActive ? "deactivate" : "activate";

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to " + actionText + " " + stateName + "?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, " + actionText,
                cancelButtonText: "Cancel"
            }).then((result) => {

                if (result.isConfirmed) {

                    var token = $("#stateStatusForm input[name='__RequestVerificationToken']").val();

                    $.ajax({
                        url: '@Url.Action("ToggleStateStatus", "Admin")',
                        type: "POST",

                        data: {
                            id: stateId,
                            __RequestVerificationToken: token
                        },

                        success: function(response) {

                            if (response.success) {

                                toastr.success(response.message);

                                setTimeout(function() {
                                    location.reload();
                                }, 700);

                            } else {

                                toastr.error(response.message);

                            }
                        },

                        error: function() {

                            toastr.error("Something went wrong while changing state status.");

                        }
                    });
                }
            });
        });

    </script>
}