@model IEnumerable<Schedule_Management.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people"></i>
                Manage Users & Coaches
            </h2>

            <p class="text-muted mb-0">
                View all registered users and coaches.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>

    <!-- SEARCH FORM START -->
    <form asp-controller="Admin"
          asp-action="Users"
          method="get"
          class="row g-2 mb-3">

        <div class="col-md-5">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search name, email or phone..." />
        </div>
        <div class="col-md-3">
            <select name="role"
                    class="form-select">

                <option value="">All Roles</option>

                <option value="User"
                        selected="@(ViewBag.Role == "User")">
                    User
                </option>

                <option value="Coach"
                        selected="@(ViewBag.Role == "Coach")">
                    Coach
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select">

                <option value="">All Status</option>

                <option value="Active"
                        selected="@(ViewBag.Status == "Active")">
                    Active
                </option>

                <option value="Inactive"
                        selected="@(ViewBag.Status == "Inactive")">
                    Inactive
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <select name="sortOrder"
                    class="form-select">

                <option value=""
                        selected="@(string.IsNullOrEmpty(ViewBag.SortOrder))">
                    Name A-Z
                </option>

                <option value="name_desc"
                        selected="@(ViewBag.SortOrder == "name_desc")">
                    Name Z-A
                </option>

                <option value="newest"
                        selected="@(ViewBag.SortOrder == "newest")">
                    Newest
                </option>

                <option value="oldest"
                        selected="@(ViewBag.SortOrder == "oldest")">
                    Oldest
                </option>

            </select>
        </div>


        <div class="col-auto">
            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-search"></i>
                Search
            </button>
        </div>

        <div class="col-auto">
            <a asp-controller="Admin"
               asp-action="Users"
               class="btn btn-secondary">
                Reset
            </a>
        </div>

    </form>
    <!-- SEARCH FORM END -->


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="text-muted mb-2">
                Total Records: @ViewBag.TotalRecords
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No users or coaches found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>District</th>
                                <th>Status</th>
                                <th>Created On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@serialNumber</td>

                                    <td>
                                        <strong>@item.FullName</strong>
                                    </td>

                                    <td>@item.Email</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            item.PhoneNumber)
                                            ? "Not provided"
                                            : item.PhoneNumber)
                                    </td>

                                    <td>
                                        @if (item.RoleName == "Coach")
                                        {
                                            <span class="badge bg-primary">
                                                Coach
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">
                                                User
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            item.DistrictName)
                                            ? "Not selected"
                                            : item.DistrictName)
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedOn.ToString(
                                            "dd MMM yyyy")
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm btn-edit-user"
                                                data-id="@item.UserId">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm @(item.IsActive ? "btn-danger" : "btn-success") btn-change-status"
                                                data-id="@item.UserId"
                                                data-active="@item.IsActive.ToString().ToLower()">

                                            @(item.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </td>
                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">

                            <!-- PREVIOUS -->
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Users"
                                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-role="@ViewBag.Role"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-sortOrder="@ViewBag.SortOrder">
                                    Previous
                                </a>
                            </li>

                            <!-- PAGE NUMBERS -->
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Users"
                                       asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-role="@ViewBag.Role"
                                       asp-route-status="@ViewBag.Status"
                                       asp-route-sortOrder="@ViewBag.SortOrder">
                                        @i
                                    </a>

                                </li>
                            }

                            <!-- NEXT -->
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Users"
                                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-role="@ViewBag.Role"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-sortOrder="@ViewBag.SortOrder">
                                    Next
                                </a>

                            </li>

                        </ul>
                    </nav>
                }
            }

        </div>
    </div>
</div>
<!--Modal Opening-->

<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Edit User / Coach</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                @Html.AntiForgeryToken()
                <form id="editUserForm">

                    <input type="hidden" id="editUserId" name="UserId" />
                    <input type="hidden" id="editRoleId" name="RoleId" />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text"
                               class="form-control"
                               id="editFullName"
                               name="FullName" />

                        <span id="fullNameError"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email"
                               class="form-control"
                               id="editEmail"
                               name="Email" />
                        <span id="emailError"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text"
                               class="form-control"
                               id="editPhoneNumber"
                               name="PhoneNumber" />
                        <span id="phoneError"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Address</label>

                        <textarea class="form-control"
                                  id="editFullAddress"
                                  name="FullAddress"
                                  rows="3"></textarea>
                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnUpdateUser">
                    Update
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).on("click", ".btn-edit-user", function() {

            var userId = $(this).data("id");

            $.ajax({
                url: '@Url.Action("GetUserById", "Admin")',
                type: 'GET',
                data: {
                    id: userId
                },

                success: function(response) {

                    if (response.success) {

                        $("#editUserId").val(response.data.userId);
                        $("#editFullName").val(response.data.fullName);
                        $("#editEmail").val(response.data.email);
                        $("#editPhoneNumber").val(response.data.phoneNumber);
                        $("#editFullAddress").val(response.data.fullAddress);
                        $("#editRoleId").val(response.data.roleId);

                        var modal = new bootstrap.Modal(
                            document.getElementById('editUserModal')
                        );

                        modal.show();
                    }
                    else {
                        toastr.error(response.message);
                    }
                },

                error: function() {
                    toastr.error("Something went wrong while loading user details.");
                }
            });

        });



        $("#btnUpdateUser").click(function() {

            // STEP 1: Purane validation errors clear
            $("#fullNameError").text("");
            $("#emailError").text("");
            $("#phoneError").text("");

            // STEP 2: Input values lena
            var fullName = $("#editFullName").val().trim();
            var email = $("#editEmail").val().trim();
            var phoneNumber = $("#editPhoneNumber").val().trim();

            var isValid = true;


            // STEP 3: Full Name validation
            if (fullName === "") {
                $("#fullNameError").text("Full Name is required.");
                isValid = false;
            }


            // STEP 4: Email validation
            if (email === "") {
                $("#emailError").text("Email is required.");
                isValid = false;
            }
            else {
                var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (!emailPattern.test(email)) {
                    $("#emailError").text("Enter a valid email address.");
                    isValid = false;
                }
            }


            // STEP 5: Phone validation
            if (phoneNumber === "") {
                $("#phoneError").text("Phone Number is required.");
                isValid = false;
            }


            // STEP 6: Validation fail hui to AJAX mat chalao
            if (!isValid) {
                return;
            }


            // STEP 7: Data prepare karo
            var formData = {
                   __RequestVerificationToken: token,
                UserId: $("#editUserId").val(),
                FullName: fullName,
                Email: email,
                PhoneNumber: phoneNumber,
                FullAddress: $("#editFullAddress").val(),
                RoleId: $("#editRoleId").val()
            };


            // STEP 8: AJAX request
            $.ajax({

                url: '@Url.Action("UpdateUser", "Admin")',
                type: 'POST',
                data: formData,

                success: function(response) {

                    if (response.success) {

                        toastr.success(response.message);

                        var modalElement =
                            document.getElementById("editUserModal");

                        var modal =
                            bootstrap.Modal.getInstance(modalElement);

                        modal.hide();

                        setTimeout(function() {
                            location.reload();
                        }, 800);
                    }
                    else {
                        toastr.error(response.message);
                    }
                },

                error: function() {
                    toastr.error(
                        "Something went wrong while updating user."
                    );
                }
            });

        });


        $(document).on("click", ".btn-change-status", function() {

            var button = $(this);
            var userId = button.data("id");
            var isActive = button.data("active");

            var actionText = isActive ? "deactivate" : "activate";
            var token = $('input[name="__RequestVerificationToken"]').val();

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to " + actionText + " this user?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, " + actionText,
                cancelButtonText: "Cancel"
            }).then(function(result) {

                if (result.isConfirmed) {

                    $.ajax({
                        url: '@Url.Action("ChangeUserStatus", "Admin")',
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token,
                            id: userId
                        },

                        success: function(response) {

                            if (response.success) {

                                toastr.success(response.message);

                                setTimeout(function() {
                                    location.reload();
                                }, 700);
                            }
                            else {
                                toastr.error(response.message);
                            }
                        },

                        error: function() {
                            toastr.error("Something went wrong while changing status.");
                        }
                    });
                }
            });
        });
    </script>
}

