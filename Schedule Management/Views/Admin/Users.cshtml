@model IEnumerable<Schedule_Management.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people"></i>
                Manage Users & Coaches
            </h2>

            <p class="text-muted mb-0">
                View all registered users and coaches.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No users or coaches found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>District</th>
                                <th>Status</th>
                                <th>Created On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@serialNumber</td>

                                    <td>
                                        <strong>@item.FullName</strong>
                                    </td>

                                    <td>@item.Email</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            item.PhoneNumber)
                                            ? "Not provided"
                                            : item.PhoneNumber)
                                    </td>

                                    <td>
                                        @if (item.RoleName == "Coach")
                                        {
                                            <span class="badge bg-primary">
                                                Coach
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">
                                                User
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            item.DistrictName)
                                            ? "Not selected"
                                            : item.DistrictName)
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedOn.ToString(
                                            "dd MMM yyyy")
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm btn-edit-user"
                                                data-id="@item.UserId">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </button>
                                    </td>
                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>
<!--Modal Opening-->

<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Edit User / Coach</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <form id="editUserForm">

                    <input type="hidden" id="editUserId" name="UserId" />
                    <input type="hidden" id="editRoleId" name="RoleId" />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text"
                               class="form-control"
                               id="editFullName"
                               name="FullName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email"
                               class="form-control"
                               id="editEmail"
                               name="Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text"
                               class="form-control"
                               id="editPhoneNumber"
                               name="PhoneNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Address</label>

                        <textarea class="form-control"
                                  id="editFullAddress"
                                  name="FullAddress"
                                  rows="3"></textarea>
                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnUpdateUser">
                    Update
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).on("click", ".btn-edit-user", function () {

            var userId = $(this).data("id");

            $.ajax({
                url: '@Url.Action("GetUserById", "Admin")',
                type: 'GET',
                data: {
                    id: userId
                },

                success: function (response) {

                    if (response.success) {

                        $("#editUserId").val(response.data.userId);
                        $("#editFullName").val(response.data.fullName);
                        $("#editEmail").val(response.data.email);
                        $("#editPhoneNumber").val(response.data.phoneNumber);
                        $("#editFullAddress").val(response.data.fullAddress);
                        $("#editRoleId").val(response.data.roleId);

                        var modal = new bootstrap.Modal(
                            document.getElementById('editUserModal')
                        );

                        modal.show();
                    }
                    else {
                        toastr.error(response.message);
                    }
                },

                error: function () {
                    toastr.error("Something went wrong while loading user details.");
                }
            });

        });
    </script>
}