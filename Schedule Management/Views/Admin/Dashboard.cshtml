@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(79, 70, 229, 0.18), transparent 30%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.16), transparent 30%), linear-gradient(135deg, #eef2ff, #f8fafc);
    }

    .dashboard-wrapper {
        padding: 45px 15px;
    }

    .dashboard-header {
        position: relative;
        overflow: hidden;
        padding: 35px;
        margin-bottom: 30px;
        border-radius: 24px;
        color: white;
        background: linear-gradient(135deg, #4f46e5, #2563eb, #0ea5e9);
        box-shadow: 0 20px 50px rgba(37, 99, 235, 0.25);
        animation: headerEnter 0.7s ease;
    }

        .dashboard-header::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -80px;
            right: -50px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            animation: floatBubble 5s ease-in-out infinite;
        }

        .dashboard-header h2,
        .dashboard-header p {
            position: relative;
            z-index: 2;
        }

        .dashboard-header h2 {
            font-weight: 750;
        }

    .dashboard-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        padding: 25px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.1);
        transition: all 0.3s ease;
        animation: cardEnter 0.7s ease both;
    }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 55px rgba(15, 23, 42, 0.16);
        }

        .dashboard-card::after {
            content: "";
            position: absolute;
            inset: auto -50px -50px auto;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: rgba(79, 70, 229, 0.08);
        }

    .pulse-icon {
        position: relative;
        width: 64px;
        height: 64px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        color: white;
        font-size: 28px;
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.28);
        animation: iconPulse 2s infinite;
    }

        .pulse-icon::before {
            content: "";
            position: absolute;
            inset: -8px;
            border: 2px solid rgba(79, 70, 229, 0.35);
            border-radius: 22px;
            animation: pulseRing 2s infinite;
        }

    .dashboard-card h5 {
        color: #1e293b;
        font-weight: 700;
    }

    .dashboard-card p {
        color: #64748b;
        min-height: 48px;
    }

    .dashboard-btn {
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 650;
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
        transition: all 0.3s ease;
    }

        .dashboard-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(37, 99, 235, 0.32);
        }

    @@keyframes iconPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }

    @@keyframes pulseRing {
        0% {
            opacity: 0.7;
            transform: scale(0.85);
        }

        100% {
            opacity: 0;
            transform: scale(1.35);
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(18px);
        }
    }

    @@keyframes headerEnter {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardEnter {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container dashboard-wrapper">

    <div class="dashboard-header">
        <h2>
            <i class="bi bi-shield-lock-fill me-2"></i>
            Admin Dashboard
        </h2>

        <p class="mb-0">
            Welcome, @Context.Session.GetString("FullName")
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="pulse-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h5>Manage Users</h5>

                <p>
                    View, edit, activate or delete registered users.
                </p>

                <a href="#"
                   class="btn btn-primary dashboard-btn">
                    Open
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="pulse-icon">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

                <h5>Manage Coaches</h5>

                <p>
                    Manage coach profiles and activity information.
                </p>

                <a href="#"
                   class="btn btn-primary dashboard-btn">
                    Open
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="pulse-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>

                <h5>Manage Locations</h5>

                <p>
                    Add or update country, state and district records.
                </p>

                <a href="#"
                   class="btn btn-primary dashboard-btn">
                    Open
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="pulse-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>

                <h5>Activity Types</h5>

                <p>
                    Manage football, cricket, hockey, yoga and more.
                </p>

                <a href="#"
                   class="btn btn-primary dashboard-btn">
                    Open
                </a>
            </div>
        </div>

    </div>
</div>