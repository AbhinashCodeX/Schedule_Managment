@model IEnumerable<Schedule_Management.ViewModels.CountryViewModel>

@{
    ViewData["Title"] = "Country Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Country Management
            </h2>

            <p class="text-muted mb-0">
                Manage countries used in the system.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addCountryModal">
            <i class="bi bi-plus-circle me-1"></i>
            Add Country
        </button>

    </div>

    <!-- FILTER FORM YAHAN ADD KARO -->

    <form method="get"
          asp-controller="Admin"
          asp-action="Countries"
          class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Search
            </label>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Country, ISO code or phone code..." />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">
                Status
            </label>

            <select name="status"
                    class="form-select">

                <option value="">
                    All Status
                </option>

                <option value="Active"
                        selected="@(ViewBag.Status == "Active")">
                    Active
                </option>

                <option value="Inactive"
                        selected="@(ViewBag.Status == "Inactive")">
                    Inactive
                </option>

            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">

            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-search me-1"></i>
                Search
            </button>

            <a asp-controller="Admin"
               asp-action="Countries"
               class="btn btn-secondary">
                Reset
            </a>

        </div>

    </form>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No countries found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Country</th>
                                <th>ISO2</th>
                                <th>ISO3</th>
                                <th>Phone Code</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.CountryName
                                    </td>

                                    <td>
                                        @item.Iso2
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Iso3)
                                            ? "-"
                                            : item.Iso3)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.PhoneCode)
                                            ? "-"
                                            : item.PhoneCode)
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-edit-country"
                                                data-id="@item.CountryId"
                                                data-name="@item.CountryName"
                                                data-iso2="@item.Iso2"
                                                data-iso3="@item.Iso3"
                                                data-phone="@item.PhoneCode">
                                            Edit
                                        </button>

                                        @if (item.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-toggle-country"
                                                    data-id="@item.CountryId"
                                                    data-name="@item.CountryName"
                                                    data-active="true">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success btn-toggle-country"
                                                    data-id="@item.CountryId"
                                                    data-name="@item.CountryName"
                                                    data-active="false">
                                                Activate
                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
                 
                @if (ViewBag.TotalPages > 0)
                {
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;

                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-3 mt-4">

                        <!-- TOTAL RECORDS -->
                        <div class="text-muted">
                            Total Countries:
                            <strong>@ViewBag.TotalRecords</strong>
                        </div>


                        <!-- PAGINATION -->
                        <nav>
                            <ul class="pagination mb-0">

                                <!-- PREVIOUS -->
                                <li class="page-item
                                    @(currentPage == 1 ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-controller="Admin"
                                       asp-action="Countries"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status">
                                        Previous
                                    </a>

                                </li>


                                <!-- PAGE NUMBERS -->
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item
                                        @(i == currentPage ? "active" : "")">

                                        <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Countries"
                                           asp-route-page="@i"
                                           asp-route-search="@ViewBag.Search"
                                           asp-route-status="@ViewBag.Status">
                                            @i
                                        </a>

                                    </li>
                                }


                                <!-- NEXT -->
                                <li class="page-item
                                    @(currentPage == totalPages ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-controller="Admin"
                                       asp-action="Countries"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status">
                                        Next
                                    </a>

                                </li>   

                            </ul>
                        </nav>

                    </div>
                }

            }

        </div>
        </div>

    </div>

</div>


<!-- ADD COUNTRY MODAL -->
<div class="modal fade"
     id="addCountryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add Country
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form id="addCountryForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Country Name
                        </label>

                        <input type="text"
                               name="CountryName"
                               class="form-control"
                               placeholder="Enter country name" />
                    </div>


                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            ISO2
                        </label>

                        <input type="text"
                               name="Iso2"
                               maxlength="2"
                               class="form-control"
                               placeholder="e.g. IN" />
                    </div>


                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            ISO3
                        </label>

                        <input type="text"
                               name="Iso3"
                               maxlength="3"
                               class="form-control"
                               placeholder="e.g. IND" />
                    </div>


                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Phone Code
                        </label>

                        <input type="text"
                               name="PhoneCode"
                               class="form-control"
                               placeholder="e.g. +91" />
                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Country
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- EDIT COUNTRY MODAL -->
<div class="modal fade"
     id="editCountryModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form id="editCountryForm">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Edit Country
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <!-- COUNTRY ID -->
                    <input type="hidden"
                           id="editCountryId"
                           name="CountryId" />


                    <!-- COUNTRY NAME -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Country Name
                        </label>

                        <input type="text"
                               id="editCountryName"
                               name="CountryName"
                               class="form-control" />

                    </div>


                    <!-- ISO2 -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            ISO2
                        </label>

                        <input type="text"
                               id="editIso2"
                               name="Iso2"
                               maxlength="2"
                               class="form-control" />

                    </div>


                    <!-- ISO3 -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            ISO3
                        </label>

                        <input type="text"
                               id="editIso3"
                               name="Iso3"
                               maxlength="3"
                               class="form-control" />

                    </div>


                    <!-- PHONE CODE -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Phone Code
                        </label>

                        <input type="text"
                               id="editPhoneCode"
                               name="PhoneCode"
                               class="form-control" />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Update Country
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<form id="countryStatusForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script>

        // ADD COUNTRY
        $("#addCountryForm").on("submit", function(e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({

                url: '@Url.Action("CreateCountry", "Admin")',

                type: 'POST',

                data: form.serialize(),

                success: function(response) {

                    if (response.success) {

                        toastr.success(response.message);

                        var modalElement =
                            document.getElementById("addCountryModal");

                        var modalInstance =
                            bootstrap.Modal.getInstance(modalElement);

                        modalInstance.hide();

                        setTimeout(function() {
                            location.reload();
                        }, 700);

                    }
                    else {

                        toastr.error(response.message);

                    }

                },

                error: function() {

                    toastr.error(
                        "Something went wrong while adding country."
                    );

                }

            });

        });

        // OPEN EDIT COUNTRY MODAL
        $(document).on("click", ".btn-edit-country", function() {

            var button = $(this);

            $("#editCountryId").val(button.data("id"));
            $("#editCountryName").val(button.data("name"));
            $("#editIso2").val(button.data("iso2"));
            $("#editIso3").val(button.data("iso3"));
            $("#editPhoneCode").val(button.data("phone"));

            var modal =
                new bootstrap.Modal(
                    document.getElementById("editCountryModal")
                );

            modal.show();
        });


        // UPDATE COUNTRY
        $("#editCountryForm").on("submit", function(e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({

                url: '@Url.Action("EditCountry", "Admin")',

                type: "POST",

                data: form.serialize(),

                success: function(response) {

                    if (response.success) {

                        toastr.success(response.message);

                        var modalElement =
                            document.getElementById("editCountryModal");

                        var modalInstance =
                            bootstrap.Modal.getInstance(modalElement);

                        modalInstance.hide();

                        setTimeout(function() {
                            location.reload();
                        }, 700);

                    }
                    else {

                        toastr.error(response.message);

                    }

                },

                error: function() {

                    toastr.error(
                        "Something went wrong while updating country."
                    );

                }

            });

        });

        // ACTIVATE / DEACTIVATE COUNTRY
        $(document).on("click", ".btn-toggle-country", function() {

            var button = $(this);

            var countryId = button.data("id");
            var countryName = button.data("name");
            var isActive = button.data("active");

            var actionText = isActive
                ? "Deactivate"
                : "Activate";

            Swal.fire({
                title: actionText + " Country?",
                text: "Are you sure you want to " +
                    actionText.toLowerCase() +
                    " " + countryName + "?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, " + actionText,
                cancelButtonText: "Cancel"
            }).then(function(result) {

                if (!result.isConfirmed) {
                    return;
                }

                var token =
                    $('#countryStatusForm input[name="__RequestVerificationToken"]').val();

                $.ajax({

                    url: '@Url.Action("ToggleCountryStatus", "Admin")',

                    type: "POST",

                    data: {
                        __RequestVerificationToken: token,
                        id: countryId
                    },

                    success: function(response) {

                        if (response.success) {

                            toastr.success(response.message);

                            setTimeout(function() {
                                location.reload();
                            }, 700);

                        }
                        else {

                            toastr.error(response.message);

                        }
                    },

                    error: function() {

                        toastr.error(
                            "Something went wrong while updating country status."
                        );

                    }

                });

            });

        });

    </script>
}