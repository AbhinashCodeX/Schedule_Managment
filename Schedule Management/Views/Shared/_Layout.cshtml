<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Schedule Management</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Schedule_Management.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">

            <div class="container-fluid">

                <!-- Project Name -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-calendar-check"></i>
                    Schedule Management

                </a>

                <!-- Mobile Navbar Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left Side Menu -->
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house"></i>
                                Home

                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            string? roleName =
                                Context.Session.GetString("RoleName");

                            if (roleName == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">

                                        <i class="bi bi-speedometer2"></i>
                                        Admin Dashboard

                                    </a>
                                </li>
                            }

                            if (roleName == "Coach")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Coach"
                                       asp-action="Dashboard">

                                        <i class="bi bi-person-badge"></i>
                                        Coach Dashboard

                                    </a>
                                </li>
                            }

                            if (roleName == "User")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="User"
                                       asp-action="Dashboard">

                                        <i class="bi bi-person"></i>
                                        User Dashboard

                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <!-- Right Side Menu -->
                    <ul class="navbar-nav">

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <!-- Logged-in User Name -->
                            <li class="nav-item">
                                <span class="nav-link text-dark">

                                    <i class="bi bi-person-circle"></i>

                                    Welcome,
                                    <strong>
                                        @Context.Session.GetString("FullName")
                                    </strong>

                                </span>
                            </li>

                            <!-- Logout Form -->
                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link text-danger border-0">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login Link -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Login

                                </a>
                            </li>

                            <!-- Register Link -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus"></i>
                                    Register

                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- Page Content -->
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Schedule Management

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>