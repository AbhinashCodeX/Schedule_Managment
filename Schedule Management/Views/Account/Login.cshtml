@model Schedule_Management.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Schedule_Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Schedule_Management.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            html,
            body {
                min-height: 100%;
            }

            body {
                position: relative;
                overflow-x: hidden;
                background: #eef2ff;
            }

            /* =========================
                       ANIMATED BACKGROUND
                    ========================= */

            .login-background {
                position: fixed;
                inset: 0;
                z-index: -10;
                overflow: hidden;
                background: linear-gradient( 125deg, #eef2ff, #e0f2fe, #f5f3ff, #ecfeff );
                background-size: 400% 400%;
                animation: backgroundFlow 14s ease infinite;
            }

                .login-background::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    opacity: 0.35;
                    background-image: linear-gradient( rgba(79, 70, 229, 0.08) 1px, transparent 1px ), linear-gradient( 90deg, rgba(79, 70, 229, 0.08) 1px, transparent 1px );
                    background-size: 45px 45px;
                    animation: gridMove 18s linear infinite;
                }

                .login-background::after {
                    content: "";
                    position: absolute;
                    width: 650px;
                    height: 650px;
                    top: 50%;
                    left: 50%;
                    border-radius: 50%;
                    background: radial-gradient( circle, rgba(99, 102, 241, 0.15), transparent 65% );
                    transform: translate(-50%, -50%);
                    animation: centerPulse 6s ease-in-out infinite;
                }

            .background-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(12px);
                opacity: 0.5;
                will-change: transform;
            }

            .blob-one {
                width: 350px;
                height: 350px;
                top: -100px;
                left: -90px;
                background: linear-gradient( 135deg, rgba(79, 70, 229, 0.8), rgba(99, 102, 241, 0.3) );
                animation: blobOneMove 12s ease-in-out infinite;
            }

            .blob-two {
                width: 420px;
                height: 420px;
                right: -140px;
                bottom: -140px;
                background: linear-gradient( 135deg, rgba(14, 165, 233, 0.65), rgba(6, 182, 212, 0.28) );
                animation: blobTwoMove 15s ease-in-out infinite;
            }

            .blob-three {
                width: 250px;
                height: 250px;
                top: 34%;
                right: 10%;
                background: linear-gradient( 135deg, rgba(168, 85, 247, 0.45), rgba(79, 70, 229, 0.22) );
                animation: blobThreeMove 11s ease-in-out infinite;
            }

            .blob-four {
                width: 220px;
                height: 220px;
                left: 8%;
                bottom: 12%;
                background: linear-gradient( 135deg, rgba(45, 212, 191, 0.4), rgba(14, 165, 233, 0.2) );
                animation: blobFourMove 13s ease-in-out infinite;
            }

            /* =========================
                       LOGIN CARD
                    ========================= */

            .login-wrapper {
                position: relative;
                z-index: 2;
                min-height: calc(100vh - 100px);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 45px 12px;
            }

            .login-card {
                position: relative;
                overflow: hidden;
                border: 1px solid rgba(255, 255, 255, 0.75);
                border-radius: 26px;
                background: linear-gradient( 145deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.84) );
                backdrop-filter: blur(22px);
                -webkit-backdrop-filter: blur(22px);
                box-shadow: 0 25px 70px rgba(30, 41, 59, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.55) inset;
                animation: cardEnter 0.8s ease, cardGlow 5s ease-in-out infinite;
                transition: transform 0.35s ease, box-shadow 0.35s ease;
            }

                .login-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 35px 90px rgba(30, 41, 59, 0.22), 0 0 35px rgba(79, 70, 229, 0.14);
                }

                .login-card::before {
                    content: "";
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 28px;
                    background: linear-gradient( 120deg, transparent 20%, rgba(99, 102, 241, 0.55), rgba(14, 165, 233, 0.5), transparent 80% );
                    background-size: 250% 250%;
                    opacity: 0.35;
                    filter: blur(8px);
                    animation: borderGlowMove 7s linear infinite;
                }

            /* =========================
                       LOGIN HEADER
                    ========================= */

            .login-header {
                position: relative;
                overflow: hidden;
                padding: 40px 25px 35px;
                color: #ffffff;
                text-align: center;
                background: linear-gradient( 120deg, #4f46e5, #2563eb, #0ea5e9, #6366f1 );
                background-size: 300% 300%;
                animation: headerGradient 9s ease infinite;
            }

                .login-header::before,
                .login-header::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.13);
                }

                .login-header::before {
                    width: 180px;
                    height: 180px;
                    top: -95px;
                    left: -55px;
                    animation: floatCircle 6s ease-in-out infinite;
                }

                .login-header::after {
                    width: 140px;
                    height: 140px;
                    right: -40px;
                    bottom: -75px;
                    animation: floatCircle 5s ease-in-out infinite reverse;
                }

            .login-icon {
                position: relative;
                z-index: 2;
                width: 76px;
                height: 76px;
                margin: 0 auto 17px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255, 255, 255, 0.35);
                border-radius: 50%;
                font-size: 32px;
                background: rgba(255, 255, 255, 0.18);
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
                animation: iconFloat 3.5s ease-in-out infinite, iconPulse 2.2s ease-out infinite;
            }

                .login-icon::before,
                .login-icon::after {
                    content: "";
                    position: absolute;
                    inset: -8px;
                    border: 2px solid rgba(255, 255, 255, 0.5);
                    border-radius: 50%;
                    opacity: 0;
                }

                .login-icon::before {
                    animation: pulseRing 2.4s ease-out infinite;
                }

                .login-icon::after {
                    animation: pulseRing 2.4s ease-out 1.2s infinite;
                }

            .login-header h2,
            .login-header p {
                position: relative;
                z-index: 2;
            }

            .login-header h2 {
                margin-bottom: 8px;
                font-weight: 750;
            }

            .login-header p {
                margin: 0;
                color: rgba(255, 255, 255, 0.86);
            }

            /* =========================
                       LOGIN BODY
                    ========================= */

            .login-body {
                padding: 38px;
            }

            .welcome-text {
                margin-bottom: 25px;
                text-align: center;
            }

                .welcome-text h5 {
                    color: #1e293b;
                    font-weight: 700;
                }

                .welcome-text p {
                    margin-bottom: 0;
                    color: #64748b;
                    font-size: 14px;
                }

            .form-group-custom {
                margin-bottom: 21px;
                animation: fieldEnter 0.65s ease both;
            }

                .form-group-custom:nth-child(1) {
                    animation-delay: 0.08s;
                }

                .form-group-custom:nth-child(2) {
                    animation-delay: 0.16s;
                }

            .form-label {
                margin-bottom: 8px;
                color: #334155;
                font-size: 14px;
                font-weight: 650;
            }

            .input-icon-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                top: 50%;
                left: 17px;
                z-index: 5;
                color: #64748b;
                pointer-events: none;
                transform: translateY(-50%);
                transition: color 0.25s ease, transform 0.25s ease;
            }

            .input-icon-wrapper .form-control {
                min-height: 53px;
                padding-left: 47px;
                padding-right: 48px;
                border: 1px solid rgba(148, 163, 184, 0.38);
                border-radius: 13px;
                background: rgba(248, 250, 252, 0.8);
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.025), 0 1px 0 rgba(255, 255, 255, 0.8) inset;
                transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
            }

                .input-icon-wrapper .form-control:hover {
                    border-color: rgba(99, 102, 241, 0.5);
                    background: rgba(255, 255, 255, 0.96);
                }

                .input-icon-wrapper .form-control:focus {
                    border-color: #6366f1;
                    background: #ffffff;
                    transform: translateY(-2px);
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12), 0 10px 25px rgba(79, 70, 229, 0.1);
                }

            .input-icon-wrapper:focus-within .input-icon {
                color: #4f46e5;
                transform: translateY(-50%) scale(1.12);
            }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 16px;
                z-index: 6;
                border: none;
                color: #64748b;
                background: transparent;
                transform: translateY(-50%);
                transition: color 0.25s ease, transform 0.25s ease;
            }

                .password-toggle:hover {
                    color: #4f46e5;
                    transform: translateY(-50%) scale(1.1);
                }

            .login-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 25px;
                font-size: 14px;
            }

            .remember-wrapper {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #475569;
            }

            .form-check-input {
                width: 17px;
                height: 17px;
                cursor: pointer;
            }

                .form-check-input:checked {
                    border-color: #4f46e5;
                    background-color: #4f46e5;
                }

            .forgot-link {
                color: #4f46e5;
                font-weight: 650;
                text-decoration: none;
            }

                .forgot-link:hover {
                    color: #2563eb;
                    text-decoration: underline;
                }

            /* =========================
                       LOGIN BUTTON
                    ========================= */

            .login-button {
                position: relative;
                overflow: hidden;
                min-height: 53px;
                border: none;
                border-radius: 14px;
                color: #ffffff;
                font-size: 16px;
                font-weight: 700;
                letter-spacing: 0.3px;
                background: linear-gradient( 120deg, #4f46e5, #2563eb, #0ea5e9, #4f46e5 );
                background-size: 300% 300%;
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.28);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                animation: buttonGradient 5s ease infinite, buttonSoftPulse 2.8s ease-in-out infinite;
            }

                .login-button::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 70%;
                    height: 100%;
                    background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.38), transparent );
                    transition: left 0.55s ease;
                }

                .login-button:hover::before {
                    left: 130%;
                }

                .login-button:hover {
                    color: #ffffff;
                    transform: translateY(-4px) scale(1.01);
                    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.4);
                }

                .login-button:active {
                    transform: translateY(-1px) scale(0.99);
                }

                .login-button:disabled {
                    cursor: not-allowed;
                    opacity: 0.75;
                }

            /* =========================
                       REGISTER LINK
                    ========================= */

            .register-link-box {
                margin-top: 25px;
                padding: 16px;
                border: 1px solid rgba(148, 163, 184, 0.18);
                border-radius: 13px;
                color: #64748b;
                text-align: center;
                background: linear-gradient( 135deg, rgba(248, 250, 252, 0.9), rgba(238, 242, 255, 0.8) );
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .register-link-box:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.1);
                }

                .register-link-box a {
                    position: relative;
                    color: #4f46e5;
                    font-weight: 700;
                    text-decoration: none;
                }

                    .register-link-box a::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        bottom: -3px;
                        width: 0;
                        height: 2px;
                        border-radius: 10px;
                        background: linear-gradient(90deg, #4f46e5, #0ea5e9);
                        transition: width 0.3s ease;
                    }

                    .register-link-box a:hover::after {
                        width: 100%;
                    }

            /* =========================
                       SUCCESS MESSAGE
                    ========================= */

            .success-message {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 22px;
                padding: 14px 16px;
                border: 1px solid rgba(34, 197, 94, 0.2);
                border-left: 4px solid #22c55e;
                border-radius: 12px;
                color: #166534;
                background: rgba(240, 253, 244, 0.92);
                animation: messageEnter 0.55s ease;
            }

                .success-message i {
                    font-size: 21px;
                    animation: successPulse 1.7s ease-in-out infinite;
                }

            .validation-summary-errors {
                margin-bottom: 20px;
                padding: 14px 16px;
                border-left: 4px solid #e11d48;
                border-radius: 12px;
                color: #be123c;
                background: #fff1f2;
            }

                .validation-summary-errors ul {
                    margin-bottom: 0;
                    padding-left: 20px;
                }

            /* =========================
                       ANIMATIONS
                    ========================= */

            @@keyframes backgroundFlow {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes gridMove {
                from {
                    background-position: 0 0;
                }

                to {
                    background-position: 90px 90px;
                }
            }

            @@keyframes centerPulse {
                0%,
                100% {
                    opacity: 0.6;
                    transform: translate(-50%, -50%) scale(0.9);
                }

                50% {
                    opacity: 1;
                    transform: translate(-50%, -50%) scale(1.15);
                }
            }

            @@keyframes blobOneMove {
                0%,
                100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(120px, 70px) scale(1.12);
                }
            }

            @@keyframes blobTwoMove {
                0%,
                100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(-130px, -80px) scale(1.1);
                }
            }

            @@keyframes blobThreeMove {
                0%,
                100% {
                    transform: translate(0, 0);
                }

                50% {
                    transform: translate(-60px, 100px);
                }
            }

            @@keyframes blobFourMove {
                0%,
                100% {
                    transform: translate(0, 0);
                }

                50% {
                    transform: translate(90px, -70px);
                }
            }

            @@keyframes cardEnter {
                from {
                    opacity: 0;
                    transform: translateY(35px) scale(0.97);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@keyframes cardGlow {
                0%,
                100% {
                    box-shadow: 0 25px 70px rgba(30, 41, 59, 0.18), 0 0 0 rgba(79, 70, 229, 0);
                }

                50% {
                    box-shadow: 0 28px 80px rgba(30, 41, 59, 0.21), 0 0 30px rgba(79, 70, 229, 0.12);
                }
            }

            @@keyframes borderGlowMove {
                from {
                    background-position: 0% 50%;
                }

                to {
                    background-position: 250% 50%;
                }
            }

            @@keyframes headerGradient {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes floatCircle {
                0%,
                100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(18px);
                }
            }

            @@keyframes iconFloat {
                0%,
                100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-7px);
                }
            }

            @@keyframes iconPulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45), 0 10px 30px rgba(15, 23, 42, 0.18);
                }

                70% {
                    box-shadow: 0 0 0 17px rgba(255, 255, 255, 0), 0 10px 30px rgba(15, 23, 42, 0.18);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0), 0 10px 30px rgba(15, 23, 42, 0.18);
                }
            }

            @@keyframes pulseRing {
                0% {
                    opacity: 0.8;
                    transform: scale(0.75);
                }

                100% {
                    opacity: 0;
                    transform: scale(1.6);
                }
            }

            @@keyframes fieldEnter {
                from {
                    opacity: 0;
                    transform: translateY(15px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes buttonGradient {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes buttonSoftPulse {
                0%,
                100% {
                    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.28);
                }

                50% {
                    box-shadow: 0 15px 38px rgba(37, 99, 235, 0.42);
                }
            }

            @@keyframes messageEnter {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes successPulse {
                0%,
                100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.15);
                }
            }

            @@media (max-width: 576px) {
                .login-wrapper {
                    padding: 25px 10px;
                }

                .login-body {
                    padding: 28px 22px;
                }

                .login-header {
                    padding: 32px 20px;
                }

                .login-options {
                    align-items: flex-start;
                    flex-direction: column;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                }
            }
    </style>
</head>


<!-- Animated Background -->
<div class="login-background" aria-hidden="true">
    <div class="background-blob blob-one"></div>
    <div class="background-blob blob-two"></div>
    <div class="background-blob blob-three"></div>
    <div class="background-blob blob-four"></div>
</div>

<!-- Login Page -->
<div class="container login-wrapper">
    <div class="row justify-content-center w-100">
        <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10">

            <div class="login-card">

                <!-- Header -->
                <div class="login-header">

                    <div class="login-icon">
                        <i class="bi bi-person-lock"></i>
                    </div>

                    <h2>Welcome Back</h2>

                    <p>
                        Login to continue to Schedule Management
                    </p>

                </div>

                <!-- Body -->
                <div class="login-body">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="success-message"
                             id="successMessage">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                @TempData["SuccessMessage"]
                            </span>

                        </div>
                    }

                    <div class="welcome-text">
                        <h5>Login to your account</h5>

                        <p>
                            Enter your registered email and password
                        </p>
                    </div>

                
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          id="loginForm">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>

                        <!-- Email -->
                        <div class="form-group-custom">

                            <label for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <div class="input-icon-wrapper">

                                <i class="bi bi-envelope input-icon"></i>

                                <input asp-for="Email"
                                    type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="Enter your email address"
                                       autocomplete="email"
                                       required />

                            </div>

                        </div>

                        <!-- Password -->
                        <div class="form-group-custom">

                            <label for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <div class="input-icon-wrapper">

                                <i class="bi bi-lock input-icon"></i>

                                <input asp-for="Password"
                                    type="password"
                                       id="Password"
                                       name="Password"
                                       class="form-control"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required />

                                <button type="button"
                                        class="password-toggle"
                                        id="passwordToggle"
                                        aria-label="Show password">

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                        </div>

                        <!-- Options -->
                        <div class="login-options">

                            <label class="remember-wrapper">

                                <input asp-for="RememberMe"
                                    type="checkbox"
                                       name="RememberMe"
                                       value="true"
                                       class="form-check-input" />

                                <span>Remember me</span>

                            </label>

                            <a href="#"
                               class="forgot-link"
                               onclick="return false;">

                                Forgot Password?

                            </a>

                        </div>

                        <!-- Login Button -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn login-button"
                                    id="loginButton">

                                <span id="loginButtonText">

                                    <i class="bi bi-box-arrow-in-right me-2"></i>

                                    Login

                                </span>

                                <span id="loginButtonLoader"
                                      class="d-none">

                                    <span class="spinner-border spinner-border-sm me-2"
                                          aria-hidden="true">
                                    </span>

                                    Logging in...

                                </span>

                            </button>

                        </div>

                    </form>

                    <!-- Register Link -->
                    <div class="register-link-box">

                        Don't have an account?

                        <a asp-controller="Account"
                           asp-action="Register">

                            Create Account

                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const passwordInput =
                document.getElementById("Password");

            const passwordToggle =
                document.getElementById("passwordToggle");

            const loginForm =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const loginButtonText =
                document.getElementById("loginButtonText");

            const loginButtonLoader =
                document.getElementById("loginButtonLoader");

            const blobs =
                document.querySelectorAll(".background-blob");

            const loginBackground =
                document.querySelector(".login-background");

            /*
             * Show/Hide Password
             */
            passwordToggle.addEventListener("click", function () {

                const icon =
                    passwordToggle.querySelector("i");

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");

                    passwordToggle.setAttribute(
                        "aria-label",
                        "Hide password"
                    );
                }
                else {

                    passwordInput.type = "password";

                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");

                    passwordToggle.setAttribute(
                        "aria-label",
                        "Show password"
                    );
                }
            });

            /*
             * Loading animation after valid submit
             */
            loginForm.addEventListener("submit", function (event) {

                if (!loginForm.checkValidity()) {
                    return;
                }

                if (window.jQuery &&
                    typeof $(loginForm).valid === "function" &&
                    !$(loginForm).valid()) {

                    return;
                }

                loginButtonText.classList.add("d-none");
                loginButtonLoader.classList.remove("d-none");
                loginButton.disabled = true;
            });

            /*
             * Mouse background parallax
             */
            document.addEventListener("mousemove", function (event) {

                const mouseX =
                    event.clientX / window.innerWidth - 0.5;

                const mouseY =
                    event.clientY / window.innerHeight - 0.5;

                blobs.forEach(function (blob, index) {

                    const movement =
                        (index + 1) * 8;

                    blob.style.translate =
                        `${mouseX * movement}px ${mouseY * movement}px`;
                });

                if (loginBackground) {

                    loginBackground.style.transform =
                        `translate(
                                    ${mouseX * 3}px,
                                    ${mouseY * 3}px
                                ) scale(1.015)`;
                }
            });

            /*
             * Automatically hide registration success message
             */
            const successMessage =
                document.getElementById("successMessage");

            if (successMessage) {

                setTimeout(function () {

                    successMessage.style.transition =
                        "opacity 0.4s ease, transform 0.4s ease";

                    successMessage.style.opacity = "0";
                    successMessage.style.transform =
                        "translateY(-8px)";

                    setTimeout(function () {
                        successMessage.remove();
                    }, 400);

                }, 5000);
            }
        });
    </script>
}