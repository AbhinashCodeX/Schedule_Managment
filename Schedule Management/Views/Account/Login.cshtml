@model Schedule_Management.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Schedule Management</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                min-height: 100%;
                font-family: Inter, "Segoe UI", sans-serif;
            }

            body {
                min-height: 100vh;
                background: #eef4f8;
                color: #172033;
                overflow-x: hidden;
            }

            /* ==========================================
                       BACKGROUND
                    ========================================== */

            .page-background {
                position: fixed;
                inset: 0;
                z-index: -5;
                overflow: hidden;
                background: radial-gradient(circle at 10% 10%, rgba(25, 118, 210, .13), transparent 30%), radial-gradient(circle at 90% 90%, rgba(14, 165, 233, .15), transparent 32%), linear-gradient(135deg, #f5f9ff, #edf6fa);
            }

            .background-grid {
                position: absolute;
                inset: 0;
                opacity: .35;
                background-image: linear-gradient(rgba(28, 79, 120, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(28, 79, 120, .06) 1px, transparent 1px);
                background-size: 48px 48px;
                animation: gridMove 22s linear infinite;
            }

            .glow {
                position: absolute;
                border-radius: 50%;
                filter: blur(12px);
                opacity: .5;
            }

            .glow-one {
                width: 350px;
                height: 350px;
                top: -140px;
                left: -100px;
                background: rgba(37, 99, 235, .18);
                animation: floatGlow 10s ease-in-out infinite;
            }

            .glow-two {
                width: 400px;
                height: 400px;
                right: -160px;
                bottom: -150px;
                background: rgba(14, 165, 233, .18);
                animation: floatGlow 13s ease-in-out infinite reverse;
            }

            /* ==========================================
                       PAGE
                    ========================================== */

            .auth-page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 36px 20px;
            }

            .auth-shell {
                width: min(1180px, 100%);
                min-height: 720px;
                display: grid;
                grid-template-columns: .92fr 1.08fr;
                overflow: hidden;
                border-radius: 32px;
                background: white;
                box-shadow: 0 30px 90px rgba(30, 58, 90, .16), 0 2px 8px rgba(15, 23, 42, .05);
                animation: shellEnter .8s ease;
            }

            /* ==========================================
                       FORM SIDE
                    ========================================== */

            .form-side {
                position: relative;
                z-index: 3;
                display: flex;
                flex-direction: column;
                padding: 48px 58px;
                background: rgba(255,255,255,.98);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #172033;
                width: fit-content;
            }

            .brand-icon {
                position: relative;
                width: 44px;
                height: 44px;
                border-radius: 14px;
                display: flex;
                justify-content: center;
                align-items: center;
                color: white;
                font-size: 20px;
                background: linear-gradient(135deg, #1d4ed8, #0ea5e9);
                box-shadow: 0 10px 28px rgba(37, 99, 235, .27);
            }

                .brand-icon::after {
                    content: "";
                    position: absolute;
                    inset: -5px;
                    border-radius: 17px;
                    border: 1px solid rgba(37, 99, 235, .25);
                    animation: brandPulse 2.4s ease-out infinite;
                }

            .brand-title {
                font-weight: 800;
                font-size: 17px;
                letter-spacing: -.2px;
            }

                .brand-title span {
                    color: #1689e9;
                }

            .form-content {
                width: 100%;
                max-width: 440px;
                margin: auto;
                padding: 48px 0 30px;
            }

            .mini-label {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.5px;
                color: #6f7d90;
                text-transform: uppercase;
            }

                .mini-label .live-dot {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #20c674;
                    box-shadow: 0 0 0 rgba(32,198,116,.5);
                    animation: livePulse 1.6s infinite;
                }

            .auth-title {
                margin: 0;
                font-size: clamp(34px, 4vw, 48px);
                line-height: 1.05;
                font-weight: 850;
                letter-spacing: -1.8px;
                color: #111827;
            }

                .auth-title span {
                    color: #1689e9;
                }

            .auth-description {
                margin: 14px 0 32px;
                color: #8792a5;
                line-height: 1.7;
                font-size: 15px;
            }

            /* ==========================================
                       TEMP DATA MESSAGE
                    ========================================== */

            .success-message {
                display: flex;
                align-items: center;
                gap: 11px;
                margin-bottom: 22px;
                padding: 13px 16px;
                color: #137046;
                background: #edfff5;
                border: 1px solid #bcebd1;
                border-radius: 13px;
                font-size: 14px;
                animation: messageEnter .45s ease;
            }

            /* ==========================================
                       VALIDATION
                    ========================================== */

            .validation-summary-errors {
                margin-bottom: 18px;
                padding: 12px 15px;
                color: #b4233d !important;
                background: #fff2f4;
                border: 1px solid #ffd2da;
                border-radius: 12px;
                font-size: 13px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 18px;
                }

            /* ==========================================
                       INPUTS
                    ========================================== */

            .form-group-custom {
                margin-bottom: 21px;
            }

            .form-label {
                margin-bottom: 8px;
                font-size: 13px;
                font-weight: 700;
                color: #49566a;
            }

            .input-wrap {
                position: relative;
            }

            .input-icon {
                position: absolute;
                left: 17px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 17px;
                color: #9aa5b5;
                pointer-events: none;
            }

            .form-control {
                height: 55px;
                padding: 0 48px 0 48px;
                border: 1px solid #dfe7ef;
                border-radius: 14px;
                background: #f7f9fc;
                color: #172033;
                font-size: 14px;
                outline: none;
                transition: all .25s ease;
            }

                .form-control::placeholder {
                    color: #adb6c4;
                }

                .form-control:hover {
                    background: #fff;
                    border-color: #c7d3df;
                }

                .form-control:focus {
                    background: white;
                    border-color: #1890ed;
                    box-shadow: 0 0 0 4px rgba(24, 144, 237, .10);
                    transform: translateY(-1px);
                }

            .password-toggle {
                position: absolute;
                right: 16px;
                top: 50%;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #8995a7;
                cursor: pointer;
                font-size: 17px;
            }

                .password-toggle:hover {
                    color: #1689e9;
                }

            /* ==========================================
                       LOGIN OPTIONS
                    ========================================== */

            .login-options {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                margin: 5px 0 28px;
                font-size: 13px;
            }

            .remember-wrapper {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #687487;
                cursor: pointer;
            }

            .form-check-input {
                width: 17px;
                height: 17px;
                margin: 0;
                cursor: pointer;
            }

            .forgot-link {
                color: #1689e9;
                text-decoration: none;
                font-weight: 700;
            }

            /* ==========================================
                       BUTTON
                    ========================================== */

            .login-button {
                width: 100%;
                min-height: 55px;
                border: 0;
                border-radius: 14px;
                color: white;
                position: relative;
                overflow: hidden;
                font-weight: 750;
                background: linear-gradient(110deg, #1689e9, #1473d1);
                box-shadow: 0 14px 30px rgba(22, 137, 233, .25);
                transition: .3s ease;
            }

                .login-button::before {
                    content: "";
                    position: absolute;
                    width: 80px;
                    height: 120%;
                    top: -10%;
                    left: -100px;
                    transform: skewX(-18deg);
                    background: rgba(255,255,255,.25);
                    transition: .55s ease;
                }

                .login-button:hover {
                    color: white;
                    transform: translateY(-3px);
                    box-shadow: 0 18px 38px rgba(22, 137, 233, .34);
                }

                    .login-button:hover::before {
                        left: 120%;
                    }

            .register-text {
                margin-top: 25px;
                text-align: center;
                font-size: 14px;
                color: #8b95a5;
            }

                .register-text a {
                    margin-left: 4px;
                    text-decoration: none;
                    color: #1689e9;
                    font-weight: 800;
                }

            /* ==========================================
                       SPORTS VISUAL SIDE
                    ========================================== */

            .sports-side {
                position: relative;
                overflow: hidden;
                min-height: 720px;
                color: white;
                background: linear-gradient( 180deg, rgba(8,18,30,.10), rgba(8,18,30,.32) ), url('https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=1400&q=90') center/cover no-repeat;
            }

                .sports-side::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(90deg, rgba(5,24,42,.12), transparent 35%), linear-gradient(0deg, rgba(4,17,30,.55), transparent 65%);
                }

            /* organic white curve */

            .sports-curve {
                position: absolute;
                z-index: 2;
                width: 130px;
                top: -8%;
                bottom: -8%;
                left: -65px;
                background: white;
                border-radius: 0 58% 44% 0 / 0 18% 22% 0;
                filter: drop-shadow(12px 0 18px rgba(9,30,49,.05));
            }

                .sports-curve::before {
                    content: "";
                    position: absolute;
                    width: 90px;
                    height: 220px;
                    right: -46px;
                    top: 32%;
                    background: white;
                    border-radius: 50%;
                }

            /* ==========================================
                       LIVE BADGE
                    ========================================== */

            .live-card {
                position: absolute;
                top: 38px;
                right: 38px;
                z-index: 5;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                border: 1px solid rgba(255,255,255,.28);
                border-radius: 100px;
                background: rgba(5,18,30,.40);
                backdrop-filter: blur(16px);
                font-size: 12px;
                font-weight: 800;
                letter-spacing: .7px;
            }

            .red-live-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #ff4258;
                box-shadow: 0 0 0 rgba(255,66,88,.7);
                animation: redLivePulse 1.35s infinite;
            }

            /* ==========================================
                       SPORT FLOATING ICONS
                    ========================================== */

            .sport-icon {
                position: absolute;
                z-index: 4;
                width: 52px;
                height: 52px;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 18px;
                border: 1px solid rgba(255,255,255,.28);
                background: rgba(10,30,45,.28);
                backdrop-filter: blur(12px);
                box-shadow: 0 12px 35px rgba(0,0,0,.15);
                font-size: 23px;
                animation: floatingIcon 4s ease-in-out infinite;
            }

            .sport-one {
                top: 155px;
                right: 55px;
            }

            .sport-two {
                top: 240px;
                left: 110px;
                animation-delay: .8s;
            }

            .sport-three {
                top: 335px;
                right: 105px;
                animation-delay: 1.4s;
            }

            /* ==========================================
                       SPORTS CONTENT
                    ========================================== */

            .sports-content {
                position: absolute;
                z-index: 5;
                left: 85px;
                right: 55px;
                bottom: 58px;
            }

            .sports-kicker {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-bottom: 15px;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            .sports-content h2 {
                max-width: 520px;
                margin-bottom: 13px;
                font-size: clamp(30px, 3.2vw, 45px);
                line-height: 1.1;
                font-weight: 850;
                letter-spacing: -1.4px;
                text-shadow: 0 3px 18px rgba(0,0,0,.17);
            }

            .sports-content > p {
                max-width: 450px;
                color: rgba(255,255,255,.82);
                font-size: 14px;
                line-height: 1.65;
            }

            /* ==========================================
                       LIVE EVENT CARD
                    ========================================== */

            .event-card {
                width: min(440px, 100%);
                margin-top: 24px;
                padding: 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 18px;
                background: rgba(7,25,39,.42);
                backdrop-filter: blur(18px);
                box-shadow: 0 14px 45px rgba(0,0,0,.16);
            }

            .event-left {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .event-icon {
                width: 45px;
                height: 45px;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 14px;
                background: rgba(255,255,255,.13);
                font-size: 22px;
            }

            .event-info strong {
                display: block;
                font-size: 13px;
            }

            .event-info span {
                display: block;
                margin-top: 4px;
                color: rgba(255,255,255,.65);
                font-size: 11px;
            }

            .event-status {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 7px 11px;
                white-space: nowrap;
                border-radius: 30px;
                color: #b8ffd9;
                background: rgba(31,201,120,.15);
                font-size: 10px;
                font-weight: 800;
            }

            .event-status-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #29df8b;
                animation: livePulse 1.5s infinite;
            }

            /* ==========================================
                       TICKER
                    ========================================== */

            .ticker {
                position: absolute;
                z-index: 6;
                top: 50%;
                right: -153px;
                width: 380px;
                padding: 8px 10px;
                overflow: hidden;
                transform: rotate(90deg);
                background: rgba(4,19,32,.50);
                backdrop-filter: blur(10px);
                border-top: 1px solid rgba(255,255,255,.15);
                border-bottom: 1px solid rgba(255,255,255,.15);
            }

            .ticker-inner {
                display: flex;
                width: max-content;
                gap: 30px;
                animation: tickerMove 13s linear infinite;
                font-size: 10px;
                letter-spacing: 1px;
                font-weight: 700;
                text-transform: uppercase;
            }

            /* ==========================================
                       ANIMATIONS
                    ========================================== */

            @@keyframes shellEnter {
                from {
                    opacity: 0;
                    transform: translateY(25px) scale(.985);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@keyframes livePulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(32,198,116,.55);
                }

                70% {
                    box-shadow: 0 0 0 9px rgba(32,198,116,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(32,198,116,0);
                }
            }

            @@keyframes redLivePulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(255,66,88,.6);
                }

                70% {
                    box-shadow: 0 0 0 9px rgba(255,66,88,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(255,66,88,0);
                }
            }

            @@keyframes brandPulse {
                0% {
                    opacity: .8;
                    transform: scale(.93);
                }

                75%, 100% {
                    opacity: 0;
                    transform: scale(1.17);
                }
            }

            @@keyframes gridMove {
                from {
                    transform: translate(0,0);
                }

                to {
                    transform: translate(48px,48px);
                }
            }

            @@keyframes floatGlow {
                0%, 100% {
                    transform: translate(0,0);
                }

                50% {
                    transform: translate(35px,25px);
                }
            }

            @@keyframes floatingIcon {
                0%, 100% {
                    transform: translateY(0) rotate(0deg);
                }

                50% {
                    transform: translateY(-13px) rotate(4deg);
                }
            }

            @@keyframes tickerMove {
                from {
                    transform: translateX(0);
                }

                to {
                    transform: translateX(-50%);
                }
            }

            @@keyframes messageEnter {
                from {
                    opacity: 0;
                    transform: translateY(-8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ==========================================
                       RESPONSIVE
                    ========================================== */

            @@media (max-width: 991px) {

                .auth-shell {
                    grid-template-columns: 1fr;
                    max-width: 620px;
                }

                .sports-side {
                    min-height: 420px;
                    order: -1;
                }

                .sports-curve,
                .ticker {
                    display: none;
                }

                .sports-content {
                    left: 35px;
                    bottom: 35px;
                }

                .form-side {
                    padding: 38px 36px;
                }

                .form-content {
                    margin: 0 auto;
                    padding-top: 45px;
                }
            }

            @@media (max-width: 576px) {

                .auth-page {
                    padding: 12px;
                }

                .auth-shell {
                    border-radius: 22px;
                }

                .form-side {
                    padding: 30px 22px;
                }

                .sports-side {
                    min-height: 340px;
                }

                .sports-content {
                    left: 24px;
                    right: 24px;
                    bottom: 24px;
                }

                    .sports-content h2 {
                        font-size: 28px;
                    }

                .sport-icon {
                    display: none;
                }

                .event-card {
                    display: none;
                }

                .live-card {
                    top: 20px;
                    right: 20px;
                }

                .login-options {
                    align-items: flex-start;
                    flex-direction: column;
                }
            }

    </style>

</head>

<body>

    <div class="page-background">
        <div class="background-grid"></div>
        <div class="glow glow-one"></div>
        <div class="glow glow-two"></div>
    </div>

    <main class="auth-page">

        <div class="auth-shell">

            <!-- ======================================
                 LEFT : LOGIN FORM
            ======================================= -->

            <section class="form-side">

                <a href="#" class="brand" onclick="return false;">

                    <div class="brand-icon">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>

                    <div class="brand-title">
                        Schedule<span>Play</span>
                    </div>

                </a>

                <div class="form-content">

                    <div class="mini-label">

                        <span class="live-dot"></span>

                        Sports scheduling is live

                    </div>

                    <h1 class="auth-title">
                        Welcome back<span>.</span>
                    </h1>

                    <p class="auth-description">
                        Login to manage schedules, activities,
                        coaches and upcoming sports sessions.
                    </p>


                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="success-message"
                             id="successMessage">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                @TempData["SuccessMessage"]
                            </span>

                        </div>
                    }


                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          id="loginForm">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>


                        <!-- EMAIL -->

                        <div class="form-group-custom">

                            <label for="Email"
                                   class="form-label">

                                Email Address

                            </label>

                            <div class="input-wrap">

                                <i class="bi bi-envelope input-icon"></i>

                                <input asp-for="Email"
                                       type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="you@example.com"
                                       autocomplete="email"
                                       required />

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group-custom">

                            <label for="Password"
                                   class="form-label">

                                Password

                            </label>

                            <div class="input-wrap">

                                <i class="bi bi-lock input-icon"></i>

                                <input asp-for="Password"
                                       type="password"
                                       id="Password"
                                       name="Password"
                                       class="form-control"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required />


                                <button type="button"
                                        class="password-toggle"
                                        id="passwordToggle"
                                        aria-label="Show password">

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                        </div>


                        <!-- REMEMBER / FORGOT -->

                        <div class="login-options">

                            <label class="remember-wrapper">

                                <input asp-for="RememberMe"
                                       type="checkbox"
                                       name="RememberMe"
                                       value="true"
                                       class="form-check-input" />

                                <span>Remember me</span>

                            </label>


                            <a href="#"
                               class="forgot-link"
                               onclick="return false;">

                                Forgot Password?

                            </a>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button type="submit"
                                class="btn login-button"
                                id="loginButton">

                            <span id="loginButtonText">

                                Login to SchedulePlay

                                <i class="bi bi-arrow-right ms-2"></i>

                            </span>


                            <span id="loginButtonLoader"
                                  class="d-none">

                                <span class="spinner-border spinner-border-sm me-2">
                                </span>

                                Logging in...

                            </span>

                        </button>

                    </form>


                    <div class="register-text">

                        New to SchedulePlay?

                        <a asp-controller="Account"
                           asp-action="Register">

                            Create your account

                        </a>

                    </div>

                </div>

            </section>


            <!-- ======================================
                 RIGHT : SPORTS VISUAL
            ======================================= -->

            <section class="sports-side">

                <div class="sports-curve"></div>


                <div class="live-card">

                    <span class="red-live-dot"></span>

                    LIVE SPORTS

                </div>


                <div class="sport-icon sport-one">
                    ⚽
                </div>

                <div class="sport-icon sport-two">
                    🏏
                </div>

                <div class="sport-icon sport-three">
                    🏀
                </div>


                <div class="ticker">

                    <div class="ticker-inner">

                        <span>● LIVE MATCH</span>
                        <span>COACH AVAILABLE</span>
                        <span>BOOK YOUR SLOT</span>
                        <span>UPCOMING SESSION</span>

                        <span>● LIVE MATCH</span>
                        <span>COACH AVAILABLE</span>
                        <span>BOOK YOUR SLOT</span>
