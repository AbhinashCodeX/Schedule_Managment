@model Schedule_Management.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Schedule_Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Schedule_Management.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                position: relative;
                overflow-x: hidden;
                background: radial-gradient(circle at top left, rgba(99, 102, 241, 0.18), transparent 30%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.16), transparent 30%), linear-gradient(135deg, #f8fafc, #eef2ff);
                min-height: 100vh;
            }

            .register-wrapper {
                padding: 50px 12px;
            }

            .register-card {
                border: none;
                border-radius: 24px;
                overflow: hidden;
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: blur(15px);
                box-shadow: 0 20px 60px rgba(15, 23, 42, 0.15);
                animation: cardEnter 0.8s ease;
            }

            .register-header {
                position: relative;
                padding: 35px 25px;
                color: white;
                text-align: center;
                overflow: hidden;
                background: linear-gradient(135deg, #4f46e5, #2563eb, #0ea5e9);
            }

                .register-header::before,
                .register-header::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.12);
                }

                .register-header::before {
                    width: 180px;
                    height: 180px;
                    top: -90px;
                    left: -50px;
                    animation: floatCircle 6s ease-in-out infinite;
                }

                .register-header::after {
                    width: 130px;
                    height: 130px;
                    right: -35px;
                    bottom: -65px;
                    animation: floatCircle 5s ease-in-out infinite reverse;
                }

            .register-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 15px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 30px;
                background: rgba(255, 255, 255, 0.18);
                border: 1px solid rgba(255, 255, 255, 0.3);
                position: relative;
                z-index: 2;
            }

            .register-header h2,
            .register-header p {
                position: relative;
                z-index: 2;
            }

            .register-header h2 {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .register-header p {
                margin: 0;
                color: rgba(255, 255, 255, 0.85);
            }

            .register-body {
                padding: 35px;
            }

            .section-title {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 20px 0 15px;
                color: #1e293b;
                font-size: 17px;
                font-weight: 700;
            }

                .section-title::after {
                    content: "";
                    height: 1px;
                    flex-grow: 1;
                    background: linear-gradient(to right, #cbd5e1, transparent);
                }

            .form-group-custom {
                position: relative;
                margin-bottom: 20px;
                animation: fieldEnter 0.6s ease both;
            }

                .form-group-custom:nth-child(1) {
                    animation-delay: 0.05s;
                }

                .form-group-custom:nth-child(2) {
                    animation-delay: 0.10s;
                }

                .form-group-custom:nth-child(3) {
                    animation-delay: 0.15s;
                }

                .form-group-custom:nth-child(4) {
                    animation-delay: 0.20s;
                }

                .form-group-custom:nth-child(5) {
                    animation-delay: 0.25s;
                }

            .form-label {
                font-size: 14px;
                font-weight: 600;
                color: #334155;
                margin-bottom: 8px;
            }

            .form-control,
            .form-select {
                min-height: 50px;
                border-radius: 12px;
                border: 1px solid #dbe3ef;
                background-color: #f8fafc;
                transition: all 0.25s ease;
            }

            textarea.form-control {
                min-height: 110px;
                resize: vertical;
            }

            .form-control:focus,
            .form-select:focus {
                background-color: white;
                border-color: #4f46e5;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
                transform: translateY(-1px);
            }

            .input-icon-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                top: 50%;
                left: 16px;
                transform: translateY(-50%);
                color: #64748b;
                z-index: 5;
                pointer-events: none;
            }

            .input-icon-wrapper .form-control,
            .input-icon-wrapper .form-select {
                padding-left: 45px;
            }

            .password-toggle {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #64748b;
                cursor: pointer;
                z-index: 6;
            }

                .password-toggle:hover {
                    color: #4f46e5;
                }

            .register-button {
                min-height: 52px;
                border: none;
                border-radius: 14px;
                font-size: 16px;
                font-weight: 700;
                letter-spacing: 0.3px;
                background: linear-gradient(135deg, #4f46e5, #2563eb);
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

                .register-button::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 70%;
                    height: 100%;
                    background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.35), transparent );
                    transition: 0.5s;
                }

                .register-button:hover::before {
                    left: 130%;
                }

                .register-button:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 35px rgba(37, 99, 235, 0.35);
                }

                .register-button:active {
                    transform: translateY(0);
                }

            .login-link-box {
                margin-top: 25px;
                padding: 15px;
                text-align: center;
                border-radius: 12px;
                background: #f8fafc;
                color: #64748b;
            }

                .login-link-box a {
                    color: #4f46e5;
                    text-decoration: none;
                    font-weight: 700;
                }

                    .login-link-box a:hover {
                        text-decoration: underline;
                    }

            .validation-summary-errors {
                padding: 14px 16px;
                margin-bottom: 20px;
                border-radius: 12px;
                background-color: #fff1f2;
                border-left: 4px solid #e11d48;
            }

            .text-danger {
                font-size: 13px;
                margin-top: 5px;
                display: block;
            }

            .loading-select {
                opacity: 0.6;
                pointer-events: none;
            }

            @@keyframes cardEnter {
                from {
                    opacity: 0;
                    transform: translateY(35px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@keyframes fieldEnter {
                from {
                    opacity: 0;
                    transform: translateY(15px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes floatCircle {
                0%, 100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(18px);
                }
            }

            @@media (max-width: 768px) {
                .register-wrapper {
                    padding: 25px 8px;
                }

                .register-body {
                    padding: 25px 20px;
                }

                .register-header {
                    padding: 28px 20px;
                }
            }

            /* ================================
                   LIVE ANIMATED BACKGROUND
                ================================ */

            html,
            body {
                min-height: 100%;
            }

            /* Main animated background */
            .animated-background {
                position: fixed;
                inset: 0;
                z-index: -10;
                overflow: hidden;
                background: linear-gradient( 125deg, #eef2ff, #e0f2fe, #f5f3ff, #ecfeff );
                background-size: 400% 400%;
                animation: backgroundFlow 14s ease infinite;
            }

                /* Animated grid */
                .animated-background::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    opacity: 0.35;
                    background-image: linear-gradient( rgba(79, 70, 229, 0.08) 1px, transparent 1px ), linear-gradient( 90deg, rgba(79, 70, 229, 0.08) 1px, transparent 1px );
                    background-size: 45px 45px;
                    animation: gridMove 18s linear infinite;
                }

                /* Soft light layer */
                .animated-background::after {
                    content: "";
                    position: absolute;
                    width: 700px;
                    height: 700px;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    border-radius: 50%;
                    background: radial-gradient( circle, rgba(99, 102, 241, 0.14), transparent 65% );
                    animation: centerPulse 6s ease-in-out infinite;
                }

            /* Floating background blobs */
            .background-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(10px);
                opacity: 0.5;
                will-change: transform;
            }

            .blob-one {
                width: 340px;
                height: 340px;
                top: -100px;
                left: -80px;
                background: linear-gradient( 135deg, rgba(79, 70, 229, 0.8), rgba(99, 102, 241, 0.35) );
                animation: blobOneMove 12s ease-in-out infinite;
            }

            .blob-two {
                width: 420px;
                height: 420px;
                right: -130px;
                bottom: -130px;
                background: linear-gradient( 135deg, rgba(14, 165, 233, 0.65), rgba(6, 182, 212, 0.3) );
                animation: blobTwoMove 15s ease-in-out infinite;
            }

            .blob-three {
                width: 260px;
                height: 260px;
                top: 35%;
                right: 8%;
                background: linear-gradient( 135deg, rgba(168, 85, 247, 0.5), rgba(79, 70, 229, 0.25) );
                animation: blobThreeMove 11s ease-in-out infinite;
            }

            .blob-four {
                width: 230px;
                height: 230px;
                bottom: 15%;
                left: 8%;
                background: linear-gradient( 135deg, rgba(45, 212, 191, 0.45), rgba(14, 165, 233, 0.2) );
                animation: blobFourMove 13s ease-in-out infinite;
            }

            /* ================================
                   CARD MODERNIZATION
                ================================ */

            .register-wrapper {
                position: relative;
                z-index: 2;
            }

            .register-card {
                position: relative;
                border: 1px solid rgba(255, 255, 255, 0.75);
                background: linear-gradient( 145deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.82) );
                backdrop-filter: blur(22px);
                -webkit-backdrop-filter: blur(22px);
                box-shadow: 0 25px 70px rgba(30, 41, 59, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.55) inset;
                transition: transform 0.35s ease, box-shadow 0.35s ease;
                animation: cardEnter 0.8s ease, cardGlow 5s ease-in-out infinite;
            }

                .register-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 35px 90px rgba(30, 41, 59, 0.23), 0 0 35px rgba(79, 70, 229, 0.12);
                }

                /* Animated border light */
                .register-card::before {
                    content: "";
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 26px;
                    background: linear-gradient( 120deg, transparent 20%, rgba(99, 102, 241, 0.55), rgba(14, 165, 233, 0.5), transparent 80% );
                    background-size: 250% 250%;
                    opacity: 0.35;
                    filter: blur(8px);
                    animation: borderGlowMove 7s linear infinite;
                }

            /* ================================
                   HEADER ANIMATION
                ================================ */

            .register-header {
                background: linear-gradient( 120deg, #4f46e5, #2563eb, #0ea5e9, #6366f1 );
                background-size: 300% 300%;
                animation: headerGradient 9s ease infinite;
            }

                .register-header::before {
                    animation: floatCircle 6s ease-in-out infinite, headerBubblePulse 4s ease-in-out infinite;
                }

                .register-header::after {
                    animation: floatCircle 5s ease-in-out infinite reverse, headerBubblePulse 5s ease-in-out infinite;
                }

            /* ================================
                   LIVE PULSE ICON
                ================================ */

            .register-icon {
                position: relative;
                box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45), 0 10px 30px rgba(15, 23, 42, 0.2);
                animation: iconFloat 3.5s ease-in-out infinite, iconPulse 2.2s ease-out infinite;
            }

                /* Outer pulse ring */
                .register-icon::before,
                .register-icon::after {
                    content: "";
                    position: absolute;
                    inset: -8px;
                    border-radius: 50%;
                    border: 2px solid rgba(255, 255, 255, 0.5);
                    opacity: 0;
                    pointer-events: none;
                }

                .register-icon::before {
                    animation: pulseRing 2.4s ease-out infinite;
                }

                .register-icon::after {
                    animation: pulseRing 2.4s ease-out 1.2s infinite;
                }

                .register-icon i {
                    animation: iconScale 2.4s ease-in-out infinite;
                }

            /* ================================
                   SECTION TITLES
                ================================ */

            .section-title {
                position: relative;
                padding: 8px 0;
            }

                .section-title i {
                    width: 34px;
                    height: 34px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 10px;
                    color: #4f46e5;
                    background: linear-gradient( 135deg, rgba(79, 70, 229, 0.14), rgba(14, 165, 233, 0.12) );
                    transition: transform 0.3s ease, box-shadow 0.3s ease;
                }

                .section-title:hover i {
                    transform: translateY(-2px) rotate(-4deg);
                    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.2);
                }

            /* ================================
                   FORM INPUT MODERNIZATION
                ================================ */

            .form-control,
            .form-select {
                border: 1px solid rgba(148, 163, 184, 0.35);
                background: rgba(248, 250, 252, 0.78);
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.025), 0 1px 0 rgba(255, 255, 255, 0.8) inset;
                transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
            }

                .form-control:hover,
                .form-select:hover {
                    border-color: rgba(99, 102, 241, 0.45);
                    background: rgba(255, 255, 255, 0.95);
                }

                .form-control:focus,
                .form-select:focus {
                    transform: translateY(-2px);
                    border-color: #6366f1;
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12), 0 10px 25px rgba(79, 70, 229, 0.1);
                    background: #ffffff;
                }

            .input-icon {
                transition: color 0.25s ease, transform 0.25s ease;
            }

            .input-icon-wrapper:focus-within .input-icon {
                color: #4f46e5;
                transform: translateY(-50%) scale(1.12);
            }

            /* Small glow around active field */
            .input-icon-wrapper::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: 12px;
                pointer-events: none;
                opacity: 0;
                box-shadow: 0 0 20px rgba(99, 102, 241, 0.18);
                transition: opacity 0.25s ease;
            }

            .input-icon-wrapper:focus-within::after {
                opacity: 1;
            }

            /* ================================
                   BUTTON LIVE EFFECT
                ================================ */

            .register-button {
                background: linear-gradient( 120deg, #4f46e5, #2563eb, #0ea5e9, #4f46e5 );
                background-size: 300% 300%;
                animation: buttonGradient 5s ease infinite, buttonSoftPulse 2.8s ease-in-out infinite;
            }

                .register-button::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient( circle at center, rgba(255, 255, 255, 0.22), transparent 65% );
                    opacity: 0;
                    transition: opacity 0.3s ease;
                }

                .register-button:hover::after {
                    opacity: 1;
                }

                .register-button:hover {
                    transform: translateY(-4px) scale(1.01);
                    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.4);
                }

                .register-button:active {
                    transform: translateY(-1px) scale(0.99);
                }

            /* ================================
                   LOGIN BOX
                ================================ */

            .login-link-box {
                border: 1px solid rgba(148, 163, 184, 0.18);
                background: linear-gradient( 135deg, rgba(248, 250, 252, 0.9), rgba(238, 242, 255, 0.8) );
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .login-link-box:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.1);
                }

                .login-link-box a {
                    position: relative;
                }

                    .login-link-box a::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        bottom: -3px;
                        width: 0;
                        height: 2px;
                        border-radius: 10px;
                        background: linear-gradient( 90deg, #4f46e5, #0ea5e9 );
                        transition: width 0.3s ease;
                    }

                    .login-link-box a:hover {
                        text-decoration: none;
                    }

                        .login-link-box a:hover::after {
                            width: 100%;
                        }

            /* ================================
                   ANIMATIONS
                ================================ */

            @@keyframes backgroundFlow {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes gridMove {
                from {
                    background-position: 0 0;
                }

                to {
                    background-position: 90px 90px;
                }
            }

            @@keyframes centerPulse {
                0%,
                100% {
                    transform: translate(-50%, -50%) scale(0.9);
                    opacity: 0.6;
                }

                50% {
                    transform: translate(-50%, -50%) scale(1.15);
                    opacity: 1;
                }
            }

            @@keyframes blobOneMove {
                0%,
                100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(120px, 70px) scale(1.12);
                }
            }

            @@keyframes blobTwoMove {
                0%,
                100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(-130px, -80px) scale(1.1);
                }
            }

            @@keyframes blobThreeMove {
                0%,
                100% {
                    transform: translate(0, 0);
                }

                50% {
                    transform: translate(-60px, 100px);
                }
            }

            @@keyframes blobFourMove {
                0%,
                100% {
                    transform: translate(0, 0);
                }

                50% {
                    transform: translate(90px, -70px);
                }
            }

            @@keyframes headerGradient {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes iconFloat {
                0%,
                100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-7px);
                }
            }

            @@keyframes iconPulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45), 0 10px 30px rgba(15, 23, 42, 0.2);
                }

                70% {
                    box-shadow: 0 0 0 16px rgba(255, 255, 255, 0), 0 10px 30px rgba(15, 23, 42, 0.2);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0), 0 10px 30px rgba(15, 23, 42, 0.2);
                }
            }

            @@keyframes pulseRing {
                0% {
                    transform: scale(0.75);
                    opacity: 0.8;
                }

                100% {
                    transform: scale(1.6);
                    opacity: 0;
                }
            }

            @@keyframes iconScale {
                0%,
                100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.08);
                }
            }

            @@keyframes cardGlow {
                0%,
                100% {
                    box-shadow: 0 25px 70px rgba(30, 41, 59, 0.18), 0 0 0 rgba(79, 70, 229, 0);
                }

                50% {
                    box-shadow: 0 28px 80px rgba(30, 41, 59, 0.21), 0 0 30px rgba(79, 70, 229, 0.12);
                }
            }

            @@keyframes borderGlowMove {
                0% {
                    background-position: 0% 50%;
                }

                100% {
                    background-position: 250% 50%;
                }
            }

            @@keyframes headerBubblePulse {
                0%,
                100% {
                    opacity: 0.12;
                }

                50% {
                    opacity: 0.23;
                }
            }

            @@keyframes buttonGradient {
                0% {
                    background-position: 0% 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0% 50%;
                }
            }

            @@keyframes buttonSoftPulse {
                0%,
                100% {
                    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
                }

                50% {
                    box-shadow: 0 15px 38px rgba(37, 99, 235, 0.42);
                }
            }

            /* Accessibility */
            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    scroll-behavior: auto !important;
                }
            }
    </style>
</head>

<div class="animated-background" aria-hidden="true">
    <div class="background-blob blob-one"></div>
    <div class="background-blob blob-two"></div>
    <div class="background-blob blob-three"></div>
    <div class="background-blob blob-four"></div>
</div>

<div class="container register-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-md-12">

            <div class="register-card">

                <div class="register-header">
                    <div class="register-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>

                    <h2>Create Your Account</h2>

                    <p>
                        Join Schedule Management as a user or coach
                    </p>
                </div>

                <div class="register-body">

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post"
                          id="registerForm">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>

                        <div class="section-title">
                            <i class="bi bi-person-vcard"></i>
                            Personal Information
                        </div>

                        <div class="row">

                            <div class="col-md-4">
                                <div class="form-group-custom">
                                    <label asp-for="FullName"
                                           class="form-label">
                                    </label>

                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-person input-icon"></i>

                                        <input asp-for="FullName"
                                               class="form-control"
                                               placeholder="Enter full name" />
                                    </div>

                                    <span asp-validation-for="FullName"
                                          class="text-danger">
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group-custom">
                                    <label asp-for="Email"
                                           class="form-label">
                                    </label>

                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-envelope input-icon"></i>

                                        <input asp-for="Email"
                                               class="form-control"
                                               placeholder="Enter email address" />
                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group-custom">
                                    <label asp-for="PhoneNumber"
