@model Schedule_Management.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Register - Schedule Management</title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <style>

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                min-height: 100%;
                font-family: Inter, "Segoe UI", sans-serif;
            }

            body {
                background: #eff5f9;
                color: #172033;
                overflow-x: hidden;
            }


            /* =====================================
                                   BACKGROUND
                                ====================================== */

            .page-background {
                position: fixed;
                inset: 0;
                z-index: -5;
                overflow: hidden;
                background: radial-gradient(circle at 10% 10%, rgba(37,99,235,.12), transparent 28%), radial-gradient(circle at 90% 90%, rgba(14,165,233,.14), transparent 30%), linear-gradient(135deg, #f4f9ff, #edf7f8);
            }

                .page-background::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    opacity: .35;
                    background-image: linear-gradient(rgba(45,91,126,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(45,91,126,.06) 1px, transparent 1px);
                    background-size: 50px 50px;
                    animation: gridMove 20s linear infinite;
                }


            .ambient-ball {
                position: absolute;
                border-radius: 50%;
                filter: blur(15px);
            }

            .ambient-one {
                width: 360px;
                height: 360px;
                left: -130px;
                top: -130px;
                background: rgba(37,99,235,.14);
                animation: ambientMove 12s ease-in-out infinite;
            }

            .ambient-two {
                width: 420px;
                height: 420px;
                bottom: -170px;
                right: -160px;
                background: rgba(14,165,233,.16);
                animation: ambientMove 14s ease-in-out infinite reverse;
            }


            /* =====================================
                                   WRAPPER
                                ====================================== */

            .register-page {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 34px 20px;
            }


            .register-shell {
                width: min(1360px, 100%);
                min-height: 790px;
                display: grid;
                grid-template-columns: 420px 1fr;
                overflow: hidden;
                border-radius: 32px;
                background: white;
                box-shadow: 0 30px 90px rgba(24,54,79,.16);
                animation: shellEnter .75s ease;
            }


            /* =====================================
                                   SPORTS PANEL
                                ====================================== */

            .sports-panel {
                min-height: 790px;
                position: relative;
                overflow: hidden;
                padding: 38px;
                color: white;
                background: linear-gradient( 180deg, rgba(5,20,34,.08), rgba(5,20,34,.58) ), url('https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1200&q=90') center/cover no-repeat;
            }


                .sports-panel::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient( circle at 30% 30%, rgba(255,255,255,.08), transparent 28% );
                }


            /* pulse rings */

            .pulse-ring {
                position: absolute;
                width: 210px;
                height: 210px;
                top: 210px;
                left: 105px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,.26);
                animation: sportsPulse 3s ease-out infinite;
            }

            .pulse-ring-two {
                animation-delay: 1.5s;
            }


            /* brand */

            .sports-brand {
                position: relative;
                z-index: 4;
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .brand-icon {
                width: 43px;
                height: 43px;
                display: flex;
                justify-content: center;
                align-items: center;
                border: 1px solid rgba(255,255,255,.30);
                border-radius: 14px;
                background: rgba(7,28,43,.33);
                backdrop-filter: blur(12px);
                font-size: 20px;
            }

            .brand-text {
                font-weight: 850;
                letter-spacing: -.3px;
            }


            /* Live badge */

            .sports-live {
                position: absolute;
                z-index: 4;
                top: 38px;
                right: 34px;
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 11px;
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 100px;
                background: rgba(5,22,36,.40);
                backdrop-filter: blur(12px);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: .8px;
            }

            .live-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #ff435c;
                animation: redPulse 1.4s infinite;
            }


            /* floating sport balls */

            .floating-sport {
                position: absolute;
                z-index: 4;
                display: flex;
                justify-content: center;
                align-items: center;
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 18px;
                background: rgba(5,25,39,.33);
                backdrop-filter: blur(14px);
                box-shadow: 0 16px 35px rgba(0,0,0,.13);
                animation: floatingSport 4s ease-in-out infinite;
            }

            .floating-football {
                width: 56px;
                height: 56px;
                top: 175px;
                left: 50px;
                font-size: 27px;
            }

            .floating-cricket {
                width: 62px;
                height: 62px;
                right: 38px;
                top: 275px;
                font-size: 28px;
                animation-delay: .8s;
            }

            .floating-basketball {
                width: 52px;
                height: 52px;
                left: 68px;
                top: 385px;
                font-size: 24px;
                animation-delay: 1.5s;
            }


            /* sports bottom content */

            .sports-content {
                position: absolute;
                z-index: 4;
                left: 38px;
                right: 38px;
                bottom: 42px;
            }

                .sports-content h2 {
                    margin-bottom: 14px;
                    font-size: 36px;
                    line-height: 1.08;
                    font-weight: 850;
                    letter-spacing: -1px;
                }

                .sports-content > p {
                    max-width: 330px;
                    margin-bottom: 22px;
                    color: rgba(255,255,255,.76);
                    font-size: 13px;
                    line-height: 1.65;
                }


            /* event list */

            .event-row {
                display: flex;
                align-items: center;
                gap: 11px;
                margin-top: 10px;
                padding: 11px 13px;
                border: 1px solid rgba(255,255,255,.19);
                border-radius: 14px;
                background: rgba(7,25,38,.35);
                backdrop-filter: blur(15px);
            }

            .event-sport-icon {
                width: 37px;
                height: 37px;
                flex: 0 0 37px;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 11px;
                background: rgba(255,255,255,.12);
            }

            .event-details {
                flex: 1;
            }

                .event-details strong {
                    display: block;
                    font-size: 11px;
                }

                .event-details span {
                    display: block;
                    margin-top: 2px;
                    color: rgba(255,255,255,.60);
                    font-size: 9px;
                }

            .availability {
                display: flex;
                align-items: center;
                gap: 5px;
                color: #adffd1;
                font-size: 8px;
                font-weight: 850;
            }

                .availability span {
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: #27dc88;
                    animation: greenPulse 1.5s infinite;
                }


            /* =====================================
                                   FORM PANEL
                                ====================================== */

            .form-panel {
                position: relative;
                padding: 45px 55px 40px;
                background: #fff;
            }

            .form-heading {
                margin-bottom: 30px;
            }

            .mini-title {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 9px;
                color: #718096;
                font-size: 11px;
                font-weight: 850;
                letter-spacing: 1.3px;
                text-transform: uppercase;
            }

                .mini-title span {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: #20c77b;
                    animation: greenPulse 1.5s infinite;
                }

            .form-heading h1 {
                margin: 0;
                color: #101828;
                font-size: 37px;
                font-weight: 850;
                letter-spacing: -1.2px;
            }

                .form-heading h1 span {
                    color: #1689e9;
                }

            .form-heading p {
                margin: 9px 0 0;
                color: #8a95a6;
                font-size: 13px;
            }


            /* =====================================
                                   SECTION HEADING
                                ====================================== */

            .section-title {
                display: flex;
                align-items: center;
                gap: 9px;
                margin: 25px 0 15px;
                color: #344054;
                font-size: 13px;
                font-weight: 800;
            }

                .section-title i {
                    color: #1689e9;
                }

                .section-title::after {
                    content: "";
                    height: 1px;
                    flex: 1;
                    background: linear-gradient( 90deg, #e3eaf1, transparent );
                }


            /* =====================================
                                   INPUTS
                                ====================================== */

            .form-group-custom {
                margin-bottom: 16px;
            }

            .form-label {
                margin-bottom: 7px;
                color: #596579;
                font-size: 12px;
                font-weight: 700;
            }

            .input-wrap {
                position: relative;
            }

            .input-icon {
                position: absolute;
                z-index: 2;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #98a5b5;
                font-size: 15px;
                pointer-events: none;
            }

            .form-control,
            .form-select {
                min-height: 48px;
                padding-left: 43px;
                border: 1px solid #dfe7ef;
                border-radius: 12px;
                background: #f8fafc;
                color: #172033;
                font-size: 13px;
                transition: .25s ease;
            }

            textarea.form-control {
                min-height: 90px;
                padding: 13px 15px;
                resize: vertical;
            }

            .form-control::placeholder {
                color: #abb4c0;
            }

            .form-control:hover,
            .form-select:hover {
                background: white;
                border-color: #cbd7e2;
            }

            .form-control:focus,
            .form-select:focus {
                background: white;
                border-color: #1689e9;
                box-shadow: 0 0 0 4px rgba(22,137,233,.10);
            }


            /* Password */

            .password-input {
                padding-right: 46px;
            }

            .password-toggle {
                position: absolute;
                z-index: 4;
                top: 50%;
                right: 14px;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #8b98a8;
                font-size: 15px;
                cursor: pointer;
            }


            /* Validation */

            .text-danger {
                display: block;
                margin-top: 4px;
                font-size: 11px;
            }

            .validation-summary-errors {
                margin-bottom: 17px;
                padding: 11px 14px;
                border: 1px solid #ffd4da;
                border-radius: 12px;
                background: #fff3f5;
                color: #b4233d !important;
                font-size: 11px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 16px;
                }


            /* =====================================
                                   REGISTER BUTTON
                                ====================================== */

            .register-button {
                min-height: 51px;
                border: 0;
                border-radius: 13px;
                color: white;
                position: relative;
                overflow: hidden;
                background: linear-gradient(110deg, #1689e9, #116fc6);
                box-shadow: 0 13px 30px rgba(22,137,233,.24);
                font-size: 14px;
                font-weight: 800;
                transition: .3s ease;
            }

                .register-button::before {
                    content: "";
                    position: absolute;
                    width: 90px;
                    height: 130%;
                    top: -15%;
                    left: -100px;
                    background: rgba(255,255,255,.24);
                    transform: skewX(-20deg);
                    transition: .55s;
                }

                .register-button:hover {
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 17px 37px rgba(22,137,233,.33);
                }

                    .register-button:hover::before {
                        left: 120%;
                    }


            .login-box {
                margin-top: 20px;
                text-align: center;
                color: #8b95a5;
                font-size: 12px;
            }

                .login-box a {
                    margin-left: 3px;
                    color: #1689e9;
                    text-decoration: none;
                    font-weight: 800;
                }


            /* =====================================
                                   ANIMATIONS
                                ====================================== */

            @@keyframes shellEnter {

                from {
                    opacity: 0;
                    transform: translateY(24px) scale(.99);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }


            @@keyframes gridMove {

                from {
                    transform: translate(0,0);
                }

                to {
                    transform: translate(50px,50px);
                }
            }


            @@keyframes ambientMove {

                0%, 100% {
                    transform: translate(0,0);
                }

                50% {
                    transform: translate(35px,25px);
                }
            }


            @@keyframes sportsPulse {

                0% {
                    opacity: .55;
                    transform: scale(.6);
                }

                80%, 100% {
                    opacity: 0;
                    transform: scale(1.65);
                }
            }


            @@keyframes floatingSport {

                0%, 100% {
                    transform: translateY(0) rotate(0);
                }

                50% {
                    transform: translateY(-13px) rotate(5deg);
                }
            }


            @@keyframes redPulse {

                0% {
                    box-shadow: 0 0 0 0 rgba(255,67,92,.60);
                }

                70% {
                    box-shadow: 0 0 0 9px rgba(255,67,92,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(255,67,92,0);
                }
            }


            @@keyframes greenPulse {

                0% {
                    box-shadow: 0 0 0 0 rgba(39,220,136,.55);
                }

                70% {
                    box-shadow: 0 0 0 8px rgba(39,220,136,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(39,220,136,0);
                }
            }


            /* =====================================
                                   RESPONSIVE
                                ====================================== */

            @@media (max-width: 1100px) {

                .register-shell {
                    grid-template-columns: 340px 1fr;
                }

                .form-panel {
                    padding: 40px 35px;
                }
            }


            @@media (max-width: 900px) {

                .register-shell {
                    grid-template-columns: 1fr;
                    max-width: 720px;
                }

                .sports-panel {
                    min-height: 360px;
                }

                .sports-content {
                    bottom: 25px;
                }

                .event-row {
                    display: none;
                }

                .floating-sport,
                .pulse-ring {
                    display: none;
                }
            }


            @@media (max-width: 576px) {

                .register-page {
                    padding: 12px;
                }

                .register-shell {
                    border-radius: 22px;
                }

                .sports-panel {
                    min-height: 290px;
                    padding: 25px;
                }

                .sports-brand {
                    font-size: 13px;
                }

                .sports-content {
                    left: 25px;
                    right: 25px;
                }

                    .sports-content h2 {
                        font-size: 28px;
                    }

                    .sports-content p {
                        display: none;
                    }

                .sports-live {
                    right: 22px;
                    top: 24px;
                }

                .form-panel {
                    padding: 30px 22px;
                }

                .form-heading h1 {
                    font-size: 31px;
                }
            }
    </style>

</head>


<body>


    <!-- BACKGROUND -->

    <div class="page-background">

        <div class="ambient-ball ambient-one"></div>

        <div class="ambient-ball ambient-two"></div>

    </div>



    <main class="register-page">


        <div class="register-shell">


            <!-- ==================================
                 SPORTS SIDE
            =================================== -->

            <aside class="sports-panel">


                <div class="sports-brand">

                    <div class="brand-icon">

                        <i class="bi bi-calendar2-check-fill"></i>

                    </div>

                    <span class="brand-text">
                        SchedulePlay
                    </span>

                </div>


                <div class="sports-live">

                    <span class="live-dot"></span>

                    SPORTS LIVE

                </div>


                <div class="pulse-ring"></div>

                <div class="pulse-ring pulse-ring-two"></div>


                <div class="floating-sport floating-football">
                    ⚽
                </div>


                <div class="floating-sport floating-cricket">
                    🏏
                </div>


                <div class="floating-sport floating-basketball">
                    🏀
                </div>


                <div class="sports-content">

                    <h2>
                        Your next game starts here.
                    </h2>

                    <p>
                        Create your account and connect with coaches,
                        activities and available sports schedules.
                    </p>


                    <div class="event-row">

                        <div class="event-sport-icon">
                            🏏
                        </div>

                        <div class="event-details">

                            <strong>
                                Cricket Practice
                            </strong>

                            <span>
                                Tomorrow • 05:30 PM
                            </span>

                        </div>


                        <div class="availability">

                            <span></span>

                            OPEN

                        </div>

                    </div>


                    <div class="event-row">

                        <div class="event-sport-icon">
                            🏀
                        </div>

                        <div class="event-details">

                            <strong>
                                Basketball Session
                            </strong>

                            <span>
                                Saturday • 07:00 AM
                            </span>

                        </div>


                        <div class="availability">

                            <span></span>

                            OPEN

                        </div>

                    </div>

                </div>

            </aside>



            <!-- ==================================
                 REGISTER FORM
            =================================== -->

            <section class="form-panel">


                <div class="form-heading">

                    <div class="mini-title">

                        <span></span>

                        Join the community

                    </div>

                    <h1>
                        Create account<span>.</span>
                    </h1>

                    <p>
                        Register as a User or Coach and start scheduling.
                    </p>

                </div>



                <form asp-controller="Account"
                      asp-action="Register"
                      method="post"
                      id="registerForm">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>



                    <!-- ===================================
                         PERSONAL INFORMATION
                    ==================================== -->

                    <div class="section-title">

                        <i class="bi bi-person-vcard"></i>

                        Personal Information

                    </div>


                    <div class="row">


                        <!-- FULL NAME -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="FullName"
                                       class="form-label">
                                </label>

                                <div class="input-wrap">

                                    <i class="bi bi-person input-icon"></i>

                                    <input asp-for="FullName"
                                           class="form-control"
                                           placeholder="Enter full name" />

                                </div>

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>



                        <!-- EMAIL -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <div class="input-wrap">

                                    <i class="bi bi-envelope input-icon"></i>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Email address" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>



                        <!-- PHONE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                </label>

                                <div class="input-wrap">

                                    <i class="bi bi-telephone input-icon"></i>

                                    <input asp-for="PhoneNumber"
                                           class="form-control"
                                           placeholder="Phone number" />

                                </div>

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>



                    <!-- ===================================
                         ACCOUNT SECURITY
                    ==================================== -->

                    <div class="section-title">

                        <i class="bi bi-shield-lock"></i>

                        Account Security

                    </div>


                    <div class="row">


                        <!-- ROLE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="RegisterAs"
                                       class="form-label">

                                    Register As

                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-people input-icon"></i>


                                    <select asp-for="RegisterAs"
                                            class="form-select">

                                        <option value="">
                                            Select Role
                                        </option>

                                        <option value="User">
                                            User
                                        </option>

                                        <option value="Coach">
                                            Coach
                                        </option>

                                    </select>

                                </div>


                                <span asp-validation-for="RegisterAs"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>



                        <!-- PASSWORD -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="Password"
                                       class="form-label">
                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-lock input-icon"></i>


                                    <input asp-for="Password"
                                           type="password"
                                           id="Password"
                                           class="form-control password-input"
                                           placeholder="Password" />


                                    <button type="button"
                                            class="password-toggle"
                                            onclick="togglePassword('Password', this)">

                                        <i class="bi bi-eye"></i>

                                    </button>

                                </div>


                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>



                        <!-- CONFIRM PASSWORD -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-lock-fill input-icon"></i>


                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           id="ConfirmPassword"
                                           class="form-control password-input"
                                           placeholder="Confirm password" />


                                    <button type="button"
                                            class="password-toggle"
                                            onclick="togglePassword('ConfirmPassword', this)">

                                        <i class="bi bi-eye"></i>

                                    </button>

                                </div>


                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>



                    <!-- ===================================
                         LOCATION
                    ==================================== -->

                    <div class="section-title">

                        <i class="bi bi-geo-alt"></i>

                        Location Details

                    </div>


                    <div class="row">


                        <!-- COUNTRY -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label class="form-label">
                                    Country
                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-globe input-icon"></i>


                                    <select id="CountryId"
                                            class="form-select">

                                        <option value="">
                                            Select Country
                                        </option>


                                        @if (ViewBag.Countries != null)
                                        {
                                            foreach (var country in ViewBag.Countries)
                                            {
                                                <option value="@country.CountryId">

                                                    @country.CountryName

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>

                            </div>

                        </div>



                        <!-- STATE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label class="form-label">
                                    State
                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-map input-icon"></i>


                                    <select id="StateId"
                                            class="form-select">

                                        <option value="">
                                            Select State
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>



                        <!-- DISTRICT -->

                        <div class="col-lg-4 col-md-6">

                            <div class="form-group-custom">

                                <label asp-for="DistrictId"
                                       class="form-label">

                                    District

                                </label>


                                <div class="input-wrap">

                                    <i class="bi bi-pin-map input-icon"></i>


                                    <select asp-for="DistrictId"
                                            id="DistrictId"
                                            class="form-select">

                                        <option value="">
                                            Select District
                                        </option>

                                    </select>

                                </div>


                                <span asp-validation-for="DistrictId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>



                    <!-- ADDRESS -->

                    <div class="form-group-custom">

                        <label asp-for="FullAddress"
                               class="form-label">

                            Full Address

                        </label>


                        <textarea asp-for="FullAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter complete address"></textarea>


                        <span asp-validation-for="FullAddress"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- REGISTER BUTTON -->

                    <div class="d-grid mt-3">


                        <button type="submit"
                                class="btn register-button"
                                id="registerButton">


                            <span id="buttonText">

                                Create My Account

                                <i class="bi bi-arrow-right ms-2"></i>

                            </span>


                            <span id="buttonLoader"
                                  class="d-none">

                                <span class="spinner-border spinner-border-sm me-2">
                                </span>

                                Creating Account...

                            </span>


                        </button>

                    </div>

                </form>



                <div class="login-box">

                    Already have an account?

                    <a asp-controller="Account"
                       asp-action="Login">

                        Login here

                    </a>

                </div>


            </section>


        </div>


    </main>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />



    <script>


            // ===========================================
            // PASSWORD SHOW / HIDE
            // ===========================================

            function togglePassword(inputId, button) {

                const input =
                    document.getElementById(inputId);

                const icon =
                    button.querySelector("i");


                if (input.type === "password") {

                    input.type = "text";

                    icon.classList.remove("bi-eye");

                    icon.classList.add("bi-eye-slash");

                }
                else {

                    input.type = "password";

                    icon.classList.remove("bi-eye-slash");

                    icon.classList.add("bi-eye");

                }

            }



            $(document).ready(function() {


                // ===========================================
                // COUNTRY -> STATE
                // YOUR EXISTING BINDING LOGIC
                // ===========================================

                $("#CountryId").on("change", function() {


                    const countryId =
                        $(this).val();


                    $("#StateId")
                        .empty()
                        .append(
                            '<option value="">Select State</option>'
                        );


                    $("#DistrictId")
                        .empty()
                        .append(
                            '<option value="">Select District</option>'
                        );


                    if (!countryId) {

                        return;

                    }


                    $.ajax({

                        url: '@Url.Action("GetStates", "Location")',

                        type: "GET",

                        data: {

                            countryId: countryId

                        },

                        success: function(states) {


                            $.each(
                                states,
                                function(index, state) {


                                    $("#StateId")
                                        .append(

                                            $("<option></option>")
                                                .val(state.stateId)
                                                .text(state.stateName)

                                        );

                                }
                            );

                        },

                        error: function(xhr) {

                            console.log(
                                "State error:",
                                xhr.responseText
                            );

                            alert(
                                "Unable to load states."
                            );

                        }

                    });

                });



                // ===========================================
                // STATE -> DISTRICT
                // YOUR EXISTING BINDING LOGIC
                // ===========================================

                $("#StateId").on("change", function() {


                    const stateId =
                        $(this).val();


                    $("#DistrictId")
                        .empty()
                        .append(
                            '<option value="">Select District</option>'
                        );


                    if (!stateId) {

                        return;

                    }


                    $.ajax({

                        url: '@Url.Action("GetDistricts", "Location")',

                        type: "GET",

                        data: {

                            stateId: stateId

                        },

                        success: function(districts) {


                            $.each(
                                districts,
                                function(index, district) {


                                    $("#DistrictId")
                                        .append(

                                            $("<option></option>")
                                                .val(district.districtId)
                                                .text(district.districtName)

                                        );

                                }
                            );

                        },

                        error: function(xhr) {

                            console.log(
                                "District error:",
                                xhr.responseText
                            );

                            alert(
                                "Unable to load districts."
                            );

                        }

                    });

                });



                // ===========================================
                // BUTTON LOADING ANIMATION
                // ONLY UI
                // ===========================================

                $("#registerForm").on(
                    "submit",
                    function() {


                        setTimeout(function() {


                            const validationErrors =
                                document.querySelectorAll(
                                    ".field-validation-error, .validation-summary-errors"
                                );


                            if (validationErrors.length === 0) {


                                $("#registerButton")
                                    .prop("disabled", true);


                                $("#buttonText")
                                    .addClass("d-none");


                                $("#buttonLoader")
                                    .removeClass("d-none");

                            }


                        }, 0);

                    }
                );


            });


    </script>


</body>

</html>