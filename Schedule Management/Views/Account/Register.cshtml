                            <div class="col-md-4">
                                <div class="form-group-custom">

                                    <label class="form-label">
                                        State
                                    </label>

                                    <div class="input-icon-wrapper">

                                        <i class="bi bi-map input-icon"></i>

                                        <select id="StateId"
                                                class="form-select">

                                            <option value="">
                                                Select State
                                            </option>

                                        </select>

                                    </div>

                                </div>
